#!/usr/bin/env bash
# .githooks/commit-msg — Comprehensive SDLC commit message enforcement
#
# Enforces:
#   1. Message length validation (min 10 chars, max 72 chars for subject line)
#   2. Format validation (conventional commits: type(scope): subject)
#   3. Task ID tracking (YYYY-MM-DD-kebab-case format)
#   4. DELEGATE/HANDBACK validation (protocol compliance)
#   5. SKIP_HOOKS bypass documentation requirement
#   6. Detailed validation reporting
#
# Install: git config core.hooksPath .githooks
# Bypass: SKIP_COMMIT_MSG_HOOK=true git commit

# Deliberately `set -uo pipefail` WITHOUT -e. This hook leans heavily on probes
# whose non-zero exit is a normal outcome (`grep -q` misses, the many `|| true`
# guards below); under -e the first such miss would abort validation silently and
# report a spurious pass/fail. Failures are tracked explicitly via fail()/ERRORS.
set -uo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check for bypass flag
if [[ "${SKIP_COMMIT_MSG_HOOK:-false}" == "true" ]]; then
    echo "⏭️  commit-msg: SKIPPED (SKIP_COMMIT_MSG_HOOK=true)"
    exit 0
fi

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

fail() {
  local message=$1
  echo -e "${RED}✗${NC} $message"
  ((ERRORS++))
}

warn() {
  local message=$1
  echo -e "${YELLOW}⚠${NC} $message"
  ((WARNINGS++))
}

success() {
  local message=$1
  echo -e "${GREEN}✓${NC} $message"
}

info() {
  local message=$1
  echo -e "${BLUE}ℹ${NC} $message"
}

# ────────────────────────────────────────────────────────────────────────────────
# 1. EXTRACT MESSAGE PARTS (strip comments and trailing whitespace)
# ────────────────────────────────────────────────────────────────────────────────

# Remove comment lines (starting with #) and empty lines
MSG_BODY=$(echo "$COMMIT_MSG" | grep -v '^#' | sed '/^$/d' || true)

# Get first line (subject)
FIRST_LINE=$(echo "$MSG_BODY" | head -n1)

# Get remaining lines (body)
MSG_BODY_REST=$(echo "$MSG_BODY" | tail -n +2 || true)

# ────────────────────────────────────────────────────────────────────────────────
# 2. VALIDATE: Non-empty message
# ────────────────────────────────────────────────────────────────────────────────

if [ -z "$FIRST_LINE" ]; then
  fail "Commit message is empty"
  echo ""
  echo "Provide a meaningful commit message. Examples:"
  echo "  feat: add token grace period validation"
  echo "  fix: resolve clock skew in mobile auth"
  echo "  docs: update SPEC.md with new routing rules"
fi

# ────────────────────────────────────────────────────────────────────────────────
# 2. VALIDATE: Message length (subject line)
# ────────────────────────────────────────────────────────────────────────────────

if [ -n "$FIRST_LINE" ]; then
  FIRST_LINE_LEN=${#FIRST_LINE}

  if [ "$FIRST_LINE_LEN" -lt 10 ]; then
    fail "Subject line too short ($FIRST_LINE_LEN chars). Minimum 10 chars required."
    echo "   Current: '$FIRST_LINE'"
  fi

  if [ "$FIRST_LINE_LEN" -gt 72 ]; then
    fail "Subject line too long ($FIRST_LINE_LEN chars). Maximum 72 chars recommended."
    echo "   Current: '$FIRST_LINE'"
  fi
fi

if [ "$FIRST_LINE_LEN" -gt 72 ]; then
  fail "Subject line too long ($FIRST_LINE_LEN chars). Maximum 72 chars recommended."
  echo "   Current: '$FIRST_LINE'"
fi

# ────────────────────────────────────────────────────────────────────────────────
# 4. VALIDATE: Conventional commit format (optional but encouraged)
# ────────────────────────────────────────────────────────────────────────────────

# Pattern: type(scope): subject OR type: subject
if [ -n "$FIRST_LINE" ]; then
  if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-z0-9\-]+\))?: .+'; then
    warn "Commit message does not follow conventional commit format"
    echo "   Expected: type(scope): subject"
    echo "   Examples: feat(auth): add token grace period"
    echo "             fix: resolve clock skew"
    echo "   Valid types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert"
  fi
fi

# ────────────────────────────────────────────────────────────────────────────────
# 5. VALIDATE: Task ID tracking (YYYY-MM-DD-kebab-case format)
# ────────────────────────────────────────────────────────────────────────────────

# Check if message contains a task ID reference
if [ -n "$COMMIT_MSG" ] && echo "$COMMIT_MSG" | grep -qE '[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9\-]+'; then
  TASK_ID=$(echo "$COMMIT_MSG" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9\-]+' | head -1)
  success "Task ID detected: $TASK_ID"
elif [ -n "$COMMIT_MSG" ]; then
  warn "No task ID found in commit message (format: YYYY-MM-DD-kebab-case)"
  echo "   Example: 2026-05-16-hooks-commitmsg-implementation"
fi

# ────────────────────────────────────────────────────────────────────────────────
# 6. VALIDATE: DELEGATE/HANDBACK protocol compliance
# ────────────────────────────────────────────────────────────────────────────────
# NOTE: Forward-compatible with both 'type:' (deprecated) and 'handoff_type:' (canonical)

if echo "$COMMIT_MSG" | grep -qE '^\s*handoff_type:\s*DELEGATE|^\s*type:\s*DELEGATE'; then
  info "DELEGATE block detected in commit message"

  # Check for required DELEGATE fields (canonical schema)
  DELEGATE_FIELDS=("task_id" "agent" "scope" "plan" "success_criteria")
  MISSING_FIELDS=()

  for field in "${DELEGATE_FIELDS[@]}"; do
    if ! echo "$COMMIT_MSG" | grep -qi "^${field}:"; then
      MISSING_FIELDS+=("$field")
    fi
  done

  if [ ${#MISSING_FIELDS[@]} -gt 0 ]; then
    fail "DELEGATE block missing required fields: ${MISSING_FIELDS[*]}"
  else
    success "DELEGATE block has all required fields"
  fi

  # Validate task_id format within DELEGATE
  if echo "$COMMIT_MSG" | grep -qE "task_id: +[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9\-]+"; then
    success "DELEGATE task_id format is valid"
  else
    fail "DELEGATE task_id format invalid (expected: YYYY-MM-DD-kebab-case)"
  fi

  # Check for deprecated fields and warn about them
  if echo "$COMMIT_MSG" | grep -qE '^\s*role:'; then
    warn "DELEGATE uses deprecated field 'role:' — use 'agent:' instead"
  fi
  if echo "$COMMIT_MSG" | grep -qE '^\s*type:\s*DELEGATE'; then
    warn "DELEGATE uses deprecated field 'type:' — use 'handoff_type:' instead"
  fi
fi

if echo "$COMMIT_MSG" | grep -qE '^\s*handoff_type:\s*HANDBACK|^\s*type:\s*HANDBACK'; then
  info "HANDBACK block detected in commit message"

  # Check for required HANDBACK fields (canonical schema)
  HANDBACK_FIELDS=("task_id" "agent" "status" "output" "metrics")
  MISSING_FIELDS=()

  for field in "${HANDBACK_FIELDS[@]}"; do
    if ! echo "$COMMIT_MSG" | grep -qi "^${field}:"; then
      MISSING_FIELDS+=("$field")
    fi
  done

  if [ ${#MISSING_FIELDS[@]} -gt 0 ]; then
    fail "HANDBACK block missing required fields: ${MISSING_FIELDS[*]}"
  else
    success "HANDBACK block has all required fields"
  fi

  # Validate status value (canonical enum)
  if echo "$COMMIT_MSG" | grep -qE "status: +(success|failure|partial|blocked|escalate)"; then
    success "HANDBACK status value is valid"
  else
    fail "HANDBACK status must be one of: success, failure, partial, blocked, escalate"
  fi

  # Check for deprecated fields and warn about them
  if echo "$COMMIT_MSG" | grep -qE '^\s*deliverables:'; then
    warn "HANDBACK uses deprecated field 'deliverables:' — use 'output:' instead"
  fi
  if echo "$COMMIT_MSG" | grep -qE '^\s*tests:'; then
    warn "HANDBACK uses deprecated field 'tests:' — use 'metrics:' instead"
  fi
  if echo "$COMMIT_MSG" | grep -qE '^\s*quality_score:'; then
    warn "HANDBACK uses deprecated field 'quality_score:' — use 'metrics.quality' instead"
  fi
  if echo "$COMMIT_MSG" | grep -qE '^\s*type:\s*HANDBACK'; then
    warn "HANDBACK uses deprecated field 'type:' — use 'handoff_type:' instead"
  fi
fi

# ────────────────────────────────────────────────────────────────────────────────
# 7. VALIDATE: SKIP_HOOKS bypass documentation
# ────────────────────────────────────────────────────────────────────────────────

if [ "${SKIP_HOOKS:-}" = "1" ] || echo "$COMMIT_MSG" | grep -qi 'SKIP_HOOKS'; then
  info "SKIP_HOOKS bypass mentioned or active"

  # Check for documented reason - must have SKIP_HOOKS: reason or similar
  if echo "$COMMIT_MSG" | grep -qiE 'SKIP_HOOKS\s*:\s*[^[:space:]]|reason\s*:\s*[^[:space:]]|emergency\s*:\s*[^[:space:]]|justification\s*:\s*[^[:space:]]'; then
    # Require non-trivial reason (>= 10 chars after the colon).
    REASON=$(echo "$COMMIT_MSG" | grep -iE '^[[:space:]]*(SKIP_HOOKS|reason|emergency|justification)[[:space:]]*:' | head -n1 | sed -E 's/^[[:space:]]*[A-Za-z_]+[[:space:]]*:[[:space:]]*//')
    if [ "${#REASON}" -lt 10 ]; then
      fail "Hook-bypass reason too short ('${REASON}'). Provide ≥10 chars (e.g. ticket ID, incident link)."
    else
      success "SKIP_HOOKS bypass is documented with reason (${#REASON} chars)"
    fi
  else
    fail "SKIP_HOOKS mentioned/used but no reason documented"
    echo "   Add one of the following (≥10 chars after the colon):"
    echo "   - SKIP_HOOKS: <reason>"
    echo "   - reason: <explanation>"
    echo "   - emergency: <justification>"
    echo "   See .githooks/README.md for the bypass procedure."
  fi
fi

# ────────────────────────────────────────────────────────────────────────────────
# 8. VALIDATE: No secrets in commit message
# ────────────────────────────────────────────────────────────────────────────────

# Look for secret patterns more specifically (key=value or : patterns)
if echo "$COMMIT_MSG" | grep -iE '(password|api_key|secret|token|private_key|aws_secret|github_token)\s*[:=]' > /dev/null 2>&1; then
  fail "Commit message contains potential secrets (password, api_key, token, etc.)"
  echo "   Do not commit secrets to git. Use environment variables or secret management."
fi

# ────────────────────────────────────────────────────────────────────────────────
# 9. SUMMARY AND EXIT
# ────────────────────────────────────────────────────────────────────────────────

echo ""
echo "─────────────────────────────────────────────────────────────────────────────"

if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}❌ commit-msg: $ERRORS error(s) found${NC}"
  echo ""
  echo "Fix the errors above and retry:"
  echo "  git commit --amend"
  echo ""
  echo "To bypass validation (not recommended):"
  echo "  SKIP_COMMIT_MSG_HOOK=true git commit"
  exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo -e "${YELLOW}⚠️  commit-msg: $WARNINGS warning(s) found${NC}"
  echo ""
  echo "Warnings are informational. Commit will proceed."
  echo "Address warnings in future commits for better practices."
  echo ""
fi

echo -e "${GREEN}✅ commit-msg: validation passed${NC}"
echo "   Subject: $FIRST_LINE"
if [ -n "$MSG_BODY_REST" ]; then
  BODY_LINES=$(echo "$MSG_BODY_REST" | wc -l)
  echo "   Body: $BODY_LINES line(s)"
fi

exit 0
