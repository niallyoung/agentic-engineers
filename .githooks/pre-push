echo "📊 Pre-push validation summary:"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  Checks passed: $CHECKS_PASSED"
echo "  Checks failed: $CHECKS_FAILED"
echo "  Errors:       $ERRORS"
echo "  Warnings:     $WARNINGS"
echo ""

if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}❌ pre-push: $ERRORS error(s) found. Fix and retry.${NC}"
  echo ""
  if [ "$QUEUE_PATH_ERRORS" -gt 0 ]; then
    echo "   Queue path errors detected:"
    echo "   • Remediation: Review queue paths in artifacts/queue/"
    echo "   • Ensure no path traversal attempts (.., /)"
    echo "   • Verify all subdirectories: incoming, processing, done, archive, failed"
    echo "   • Check for legacy paths: ~/.copilot/queue/, ~/.claude/queue/"
    echo ""
    echo "   Audit log: $QUEUE_AUDIT_LOG"
    echo ""
    echo "   Secure bypass: SKIP_QUEUE_PATH_VALIDATION=true git push"
    echo "   (This still requires SKIP_HOOKS=1 for full emergency bypass)"
    echo ""
  fi
  echo "   Emergency bypass: SKIP_HOOKS=1 git push"
  echo ""
  exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo -e "${YELLOW}⚠️  pre-push: $WARNINGS warning(s) — proceeding (warnings are non-blocking)${NC}"
  echo ""
fi

echo -e "${GREEN}✅ pre-push: quality gate passed${NC}"
