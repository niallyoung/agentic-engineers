#!/usr/bin/env bash
# .githooks/pre-push — SDLC pre-push quality gate
#
# Enforces:
#   1. Agent YAML validation (agents/*.md frontmatter)
#   2. Test suite execution (pytest)
#   3. Documentation consistency (SPEC.md, AGENTS.md, etc.)
#   4. Workflow validation (GitHub Actions YAML)
#   5. Main/master push warnings
#   6. DELEGATE/HANDBACK protocol compliance
#   7. Agent definition verification (AGENTS.md ↔ .agents_verification_sha)
#
# Install: git config core.hooksPath .githooks
# Bypass (all): SKIP_HOOKS=1 git push
# Bypass (agent verification only): SKIP_AGENT_VERIFICATION=1 git push

set -euo pipefail

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "⚠️  SKIP_HOOKS=1 set — bypassing pre-push enforcement (emergency only)"
  exit 0
fi

REMOTE="$1"
URL="$2"

ERRORS=0
WARNINGS=0
CHECKS_PASSED=0
CHECKS_FAILED=0

# ─────────────────────────────────────────────────────────────────────────────
# CAPTURE GIT REFS BEFORE STDIN CONSUMPTION
# ─────────────────────────────────────────────────────────────────────────────
# These vars are needed later in queue validation but stdin will be consumed
# by the read loop. Capture them upfront to avoid empty variable bug.
LOCAL_SHA=""
REMOTE_SHA=""

# Color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

fail() {
  echo -e "${RED}❌${NC} $1"
  ERRORS=$((ERRORS + 1))
  CHECKS_FAILED=$((CHECKS_FAILED + 1))
}

warn() {
  echo -e "${YELLOW}⚠️ ${NC} $1"
  WARNINGS=$((WARNINGS + 1))
}

pass() {
  echo -e "${GREEN}✅${NC} $1"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
}

info() {
  echo -e "${BLUE}ℹ️ ${NC} $1"
}

# ─────────────────────────────────────────────────────────────────────────────
# 1. DETECT PUSH TO MAIN/MASTER
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "📋 Pre-push validation starting..."
echo ""

PUSHING_TO_PROTECTED=0
while read local_ref local_sha remote_ref remote_sha; do
  # Capture refs for use after stdin is consumed
  LOCAL_SHA="$local_sha"
  REMOTE_SHA="$remote_sha"
  
  if echo "$remote_ref" | grep -qE 'refs/heads/(main|master)$'; then
    PUSHING_TO_PROTECTED=1
    warn "Pushing to protected branch: $remote_ref"
    warn "Ensure Quality Engineer review is complete before merge"
  fi
done

# ─────────────────────────────────────────────────────────────────────────────
# 2. VALIDATE AGENT YAML FRONTMATTER
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🤖 Validating agent definitions..."

AGENT_YAML_ERRORS=0
if command -v python3 >/dev/null 2>&1; then
  # Check src/agents/*.md files
  if [ -d "src/agents" ]; then
    for f in src/agents/*.md; do
      [ -f "$f" ] || continue
      
      # Skip README files
      if [[ "$f" == *"README"* ]]; then
        continue
      fi
      
      # Extract YAML frontmatter (between --- markers)
      FM=$(awk '/^---/{if(p)exit; p=1; next} p' "$f" 2>/dev/null || true)
      
      if [ -n "$FM" ]; then
        # Validate YAML syntax
        if ! echo "$FM" | python3 -c "import sys,yaml; yaml.safe_load(sys.stdin)" 2>/dev/null; then
          fail "Invalid YAML frontmatter in agent: $f"
          AGENT_YAML_ERRORS=$((AGENT_YAML_ERRORS + 1))
        fi
        
        # Validate required fields: name, model (role and effort are in markdown content)
        for field in "name" "model"; do
          if ! echo "$FM" | grep -q "^$field:"; then
            fail "Missing required field '$field' in agent: $f"
            AGENT_YAML_ERRORS=$((AGENT_YAML_ERRORS + 1))
          fi
        done
      fi
    done
    
    if [ "$AGENT_YAML_ERRORS" -eq 0 ]; then
      pass "Agent YAML frontmatter valid"
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 3. VALIDATE WORKFLOW FILES (GitHub Actions)
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🔄 Validating workflow files..."

WORKFLOW_ERRORS=0
if command -v python3 >/dev/null 2>&1; then
  if [ -d ".github/workflows" ]; then
    for f in .github/workflows/*.yml .github/workflows/*.yaml; do
      [ -f "$f" ] || continue
      
      # Validate YAML syntax
      if ! python3 -c "import sys,yaml; yaml.safe_load(open('$f'))" 2>/dev/null; then
        fail "Invalid YAML in workflow: $f"
        WORKFLOW_ERRORS=$((WORKFLOW_ERRORS + 1))
      fi
      
      # Check for required workflow fields
      if ! grep -q "^name:" "$f"; then
        fail "Missing 'name' field in workflow: $f"
        WORKFLOW_ERRORS=$((WORKFLOW_ERRORS + 1))
      fi
      
      if ! grep -q "^on:" "$f"; then
        fail "Missing 'on' (trigger) field in workflow: $f"
        WORKFLOW_ERRORS=$((WORKFLOW_ERRORS + 1))
      fi
    done
    
    if [ "$WORKFLOW_ERRORS" -eq 0 ] && [ -d ".github/workflows" ] && [ "$(ls -1 .github/workflows/*.{yml,yaml} 2>/dev/null | wc -l)" -gt 0 ]; then
      pass "Workflow files valid"
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 4. VALIDATE DOCUMENTATION CONSISTENCY
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "📚 Validating documentation consistency..."

DOC_ERRORS=0

# Check for SPEC.md
if [ ! -f "docs/SPEC.md" ]; then
  fail "docs/SPEC.md not found"
  DOC_ERRORS=$((DOC_ERRORS + 1))
else
  # Validate SPEC.md has required sections
  if ! grep -q "^# " docs/SPEC.md; then
    fail "docs/SPEC.md missing top-level heading"
    DOC_ERRORS=$((DOC_ERRORS + 1))
  fi
  
  if ! grep -q "version:" docs/SPEC.md; then
    fail "docs/SPEC.md missing version field"
    DOC_ERRORS=$((DOC_ERRORS + 1))
  fi
fi

# Check for AGENTS.md
if [ ! -f "docs/AGENTS.md" ]; then
  fail "docs/AGENTS.md not found"
  DOC_ERRORS=$((DOC_ERRORS + 1))
else
  # Validate AGENTS.md has required sections
  if ! grep -q "^# " docs/AGENTS.md; then
    fail "docs/AGENTS.md missing top-level heading"
    DOC_ERRORS=$((DOC_ERRORS + 1))
  fi
fi

# Check for README.md
if [ ! -f "README.md" ]; then
  fail "README.md not found"
  DOC_ERRORS=$((DOC_ERRORS + 1))
fi

if [ "$DOC_ERRORS" -eq 0 ]; then
  pass "Documentation files present and valid"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 5. VALIDATE DELEGATE/HANDBACK PROTOCOL COMPLIANCE
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "📦 Validating DELEGATE/HANDBACK protocol..."

PROTOCOL_ERRORS=0
if command -v python3 >/dev/null 2>&1; then
  # Check artifacts/delegates/ for DELEGATE files
  if [ -d "artifacts/delegates" ]; then
    for f in artifacts/delegates/*/*.yaml artifacts/delegates/*/*.yml; do
      [ -f "$f" ] || continue
      
      # Validate YAML syntax
      if ! python3 -c "import sys,yaml; yaml.safe_load(open('$f'))" 2>/dev/null; then
        fail "Invalid YAML in DELEGATE: $f"
        PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        continue
      fi
      
      # Check for required DELEGATE fields
      for field in "handoff_type" "task_id" "role" "model"; do
        if ! grep -q "^$field:" "$f"; then
          fail "Missing required field '$field' in DELEGATE: $f"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
      done
    done
  fi
  
  # Check artifacts/queue/processing/ for HANDBACK files
  if [ -d "artifacts/queue/processing" ]; then
    for f in artifacts/queue/processing/*.yaml artifacts/queue/processing/*.yml; do
      [ -f "$f" ] || continue
      
      # Validate YAML syntax
      if ! python3 -c "import sys,yaml; yaml.safe_load(open('$f'))" 2>/dev/null; then
        fail "Invalid YAML in HANDBACK: $f"
        PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        continue
      fi
      
      # Check for required HANDBACK fields
      for field in "handoff_type" "task_id" "status"; do
        if ! grep -q "^$field:" "$f"; then
          fail "Missing required field '$field' in HANDBACK: $f"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
      done
    done
  fi
  
  if [ "$PROTOCOL_ERRORS" -eq 0 ]; then
    pass "DELEGATE/HANDBACK protocol valid"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 5b. QUEUE PATH VALIDATION (Security hardening)
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🔒 Validating queue paths (security)..."

QUEUE_PATH_ERRORS=0
QUEUE_AUDIT_LOG=".git/hooks.audit.log"
TIMESTAMP=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

# Helper function to validate a single queue path
validate_queue_path() {
  local path="$1"
  local is_legacy="${2:-0}"
  
  # Check for null bytes and other dangerous characters
  if echo "$path" | grep -qE '[\x00\x01-\x08\x0B\x0C\x0E-\x1F]'; then
    fail "Queue path contains null/control characters: $path"
    echo "[$TIMESTAMP] INVALID_PATH (control chars): $path" >> "$QUEUE_AUDIT_LOG"
    QUEUE_PATH_ERRORS=$((QUEUE_PATH_ERRORS + 1))
    return 1
  fi
  
  # Check for path traversal (.. or leading /)
  if echo "$path" | grep -qE '(\.\./|^\/)'; then
    fail "Queue path contains traversal attempt: $path"
    echo "[$TIMESTAMP] TRAVERSAL_ATTEMPT: $path" >> "$QUEUE_AUDIT_LOG"
    QUEUE_PATH_ERRORS=$((QUEUE_PATH_ERRORS + 1))
    return 1
  fi
  
  # Check for symbolic links pointing outside queue
  if [ -L "$path" ]; then
    local target
    target=$(readlink -f "$path")
    if ! echo "$target" | grep -q "artifacts/queue"; then
      fail "Symbolic link points outside queue: $path → $target"
      echo "[$TIMESTAMP] SYMLINK_ESCAPE: $path → $target" >> "$QUEUE_AUDIT_LOG"
      QUEUE_PATH_ERRORS=$((QUEUE_PATH_ERRORS + 1))
      return 1
    fi
  fi
  
  # Check for legacy paths (security risk)
  if [ "$is_legacy" -eq 1 ]; then
    warn "Legacy queue path detected (deprecated): $path"
    echo "[$TIMESTAMP] LEGACY_PATH: $path" >> "$QUEUE_AUDIT_LOG"
    return 1
  fi
  
  return 0
}

# Helper function to validate subdirectory structure
validate_queue_subdirs() {
  local queue_root="$1"
  local session_dir="$2"
  
  # Expected subdirectories for a session
  local expected_subdirs=("incoming" "processing" "done" "archive" "failed")
  
  # Check for unexpected directories
  for subdir in "$queue_root/$session_dir"/*; do
    [ -d "$subdir" ] || continue
    
    local subdir_name
    subdir_name=$(basename "$subdir")
    
    # Check if it's a UUID (session directory itself)
    if echo "$subdir_name" | grep -qE '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
      # This is a session ID, recurse into it
      for expected in "${expected_subdirs[@]}"; do
        if [ ! -d "$subdir/$expected" ]; then
          warn "Expected subdirectory missing in session: $subdir/$expected"
        fi
      done
      continue
    fi
    
    # Check if subdir name is one of the expected ones
    local found=0
    for expected in "${expected_subdirs[@]}"; do
      if [ "$subdir_name" = "$expected" ]; then
        found=1
        break
      fi
    done
    
    if [ "$found" -eq 0 ]; then
      fail "Unexpected queue subdirectory name: $subdir_name (expected: incoming|processing|done|archive|failed)"
      echo "[$TIMESTAMP] INVALID_SUBDIR: $subdir_name in $session_dir" >> "$QUEUE_AUDIT_LOG"
      QUEUE_PATH_ERRORS=$((QUEUE_PATH_ERRORS + 1))
    fi
  done
}

# Detect if bypass is requested
BYPASS_QUEUE_VALIDATION=0
if [ "${SKIP_QUEUE_PATH_VALIDATION:-}" = "true" ]; then
  BYPASS_QUEUE_VALIDATION=1
  warn "Queue path validation BYPASSED: SKIP_QUEUE_PATH_VALIDATION=true"
  echo "[$TIMESTAMP] BYPASS_REQUESTED: SKIP_QUEUE_PATH_VALIDATION=true" >> "$QUEUE_AUDIT_LOG"
fi

# Check for queue changes in the push
QUEUE_CHANGES=$(git diff --name-only "$LOCAL_SHA" "$REMOTE_SHA" 2>/dev/null | grep -E '^artifacts/queue/' || true)

if [ -n "$QUEUE_CHANGES" ] && [ "$BYPASS_QUEUE_VALIDATION" -eq 0 ]; then
  echo "  Queue changes detected, validating paths..."
  
  # Check for changes to artifacts/queue/ directory
  if git diff --name-only HEAD | grep -q '^artifacts/queue/'; then
    # Get list of changed files in queue (already includes artifacts/queue/ prefix)
    CHANGED_QUEUE_FILES=$(git diff --name-only HEAD -- artifacts/queue/ 2>/dev/null || true)
    
    if [ -n "$CHANGED_QUEUE_FILES" ]; then
      echo "$CHANGED_QUEUE_FILES" | while read -r queue_file; do
        # Validate each changed path (queue_file already has full path prefix)
        validate_queue_path "$queue_file" 0 || true
      done
    fi
  fi
  
  # Check for legacy paths in tracked files
  LEGACY_PATHS=()
  
  # Check ~/.copilot/queue/ references (legacy)
  if git diff --unified=0 "$LOCAL_SHA" "$REMOTE_SHA" 2>/dev/null | grep -E '~/.copilot/queue/|~/.claude/queue/'; then
    warn "Legacy queue paths detected in changes (~/.copilot/queue/ or ~/.claude/queue/)"
    echo "[$TIMESTAMP] LEGACY_PATHS: ~/.copilot/queue/ or ~/.claude/queue/" >> "$QUEUE_AUDIT_LOG"
    QUEUE_PATH_ERRORS=$((QUEUE_PATH_ERRORS + 1))
  fi
  
  # Validate queue subdirectory structure
  if [ -d "artifacts/queue" ]; then
    for session_dir in artifacts/queue/*/; do
      [ -d "$session_dir" ] || continue
      session_name=$(basename "$session_dir")
      
      # Skip if it looks like a UUID
      if echo "$session_name" | grep -qE '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
        # Validate subdirectories in session
        for expected in "incoming" "processing" "done" "archive" "failed"; do
          # These are optional but if present must be named correctly
          [ -d "$session_dir/$expected" ] || continue
        done
      elif [ "$session_name" != "default" ] && [ "$session_name" != "incoming-legacy-"* ]; then
        # Only warn about unexpected names, don't fail
        warn "Unusual queue session directory: $session_name"
      fi
    done
  fi
  
elif [ "$BYPASS_QUEUE_VALIDATION" -eq 1 ]; then
  echo "  Queue validation SKIPPED (bypass enabled)"
  echo "[$TIMESTAMP] BYPASS: No queue validation performed (SKIP_QUEUE_PATH_VALIDATION=true)" >> "$QUEUE_AUDIT_LOG"
fi

# Summary of queue validation
if [ "$QUEUE_PATH_ERRORS" -eq 0 ] && [ "$BYPASS_QUEUE_VALIDATION" -eq 0 ]; then
  pass "Queue paths validated successfully"
elif [ "$QUEUE_PATH_ERRORS" -eq 0 ] && [ "$BYPASS_QUEUE_VALIDATION" -eq 1 ]; then
  pass "Queue path validation bypassed (no errors would have occurred)"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 6. GENERATE DIST/ ARTIFACTS (RENDER PIPELINE)
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🔨 Rendering dist/ artifacts..."

RENDER_ERRORS=0
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v make >/dev/null 2>&1; then
  # Render all harnesses (copilot, claude, opencode, pi, specs)
  # These are generated artifacts required by tests
  if make render-copilot render-claude render-opencode render-pi render-specs >/dev/null 2>&1; then
    pass "Render pipeline complete"
  else
    warn "Render pipeline encountered issues — review before pushing"
    RENDER_ERRORS=$((RENDER_ERRORS + 1))
  fi
else
  warn "make not found — skipping render pipeline"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 7. RUN TEST SUITE
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🧪 Running test suite..."

TEST_ERRORS=0
# Skip pytest if SKIP_PYTEST is set (for testing the hook itself)
if [ "${SKIP_PYTEST:-}" != "1" ] && command -v pytest >/dev/null 2>&1 && [ -d "tests" ]; then
  # Run pytest with quiet output and timeout
  # Skip test_git_hooks.py as it can hang during hook execution
  if timeout 30 pytest tests/ -q --tb=line --ignore=tests/test_git_hooks.py 2>/dev/null; then
    pass "All tests passed"
  else
    PYTEST_EXIT=$?
    if [ "$PYTEST_EXIT" -eq 124 ]; then
      warn "Test suite timed out (>30s) — review before pushing"
    else
      warn "Some tests failed — review before pushing to shared branches"
    fi
    TEST_ERRORS=$((TEST_ERRORS + 1))
  fi
elif [ -d "tests" ]; then
  warn "pytest not found or skipped — skipping test execution"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 6b. RUN CONCURRENT TESTS (race condition guard)
# ─────────────────────────────────────────────────────────────────────────────
#
# TestConcurrentInvocations::test_concurrent_invocations_independent_files
# has a history of flaking in CI due to a TOCTOU race between the HANDBACK
# file poller and the writer thread.  Running it three times locally (the
# test itself spawns threads; no -n / xdist needed) ensures the fix holds
# before the commit reaches CI.
#
echo ""
echo "🔀 Running concurrent invocation tests (race condition guard)..."

CONCURRENT_ERRORS=0
if [ "${SKIP_PYTEST:-}" != "1" ] && command -v pytest >/dev/null 2>&1 && [ -d "tests" ]; then
  if timeout 60 pytest tests/test_invoke_agent.py::TestConcurrentInvocations \
        -q --tb=short 2>/dev/null; then
    pass "Concurrent invocation tests passed"
  else
    PYTEST_EXIT=$?
    if [ "$PYTEST_EXIT" -eq 124 ]; then
      fail "Concurrent invocation tests timed out (>60s) — race condition suspected"
    else
      fail "Concurrent invocation tests FAILED — race condition detected. Fix before pushing."
    fi
    CONCURRENT_ERRORS=$((CONCURRENT_ERRORS + 1))
    ERRORS=$((ERRORS + 1))
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# 8. VALIDATE SPEC COMPLIANCE (No external scripts except renderer/)
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🔐 Validating SPEC compliance..."

SPEC_ERRORS=0

# Check for orchestration/scripts/ (should not exist)
if [ -d "orchestration/scripts" ] && [ "$(find orchestration/scripts -type f \( -name "*.py" -o -name "*.sh" \) 2>/dev/null | wc -l)" -gt 0 ]; then
  fail "External scripts found in orchestration/scripts/ — violates SPEC.md"
  SPEC_ERRORS=$((SPEC_ERRORS + 1))
fi

# Check for orchestration/config/*.cron (should not exist)
if [ -d "orchestration/config" ] && [ "$(find orchestration/config -name "*.cron" -type f 2>/dev/null | wc -l)" -gt 0 ]; then
  fail "Cron files found in orchestration/config/ — violates SPEC.md"
  SPEC_ERRORS=$((SPEC_ERRORS + 1))
fi

# Check Makefile for direct script invocations (except renderer/)
if grep -E "^\s+@(bash|sh|python).*scripts" Makefile 2>/dev/null | grep -v "renderer/scripts" | grep -q . ; then
  fail "Makefile invokes external scripts (not in renderer/) — violates SPEC.md"
  SPEC_ERRORS=$((SPEC_ERRORS + 1))
fi

if [ "$SPEC_ERRORS" -eq 0 ]; then
  pass "SPEC compliance verified"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 9. AGENT DEFINITION VERIFICATION (docs/AGENTS.md ↔ .agents_verification_sha)
# ─────────────────────────────────────────────────────────────────────────────
echo ""
echo "🔐 Verifying agent definitions..."

AGENT_VERIFY_ERRORS=0
REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT_LOG=".git/hooks.audit.log"

# Function to log audit event
log_audit() {
  local event="$1"
  local bypass_reason="${2:-}"
  timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  if [ -n "$bypass_reason" ]; then
    echo "[$timestamp] $event | bypass_reason: $bypass_reason" >> "$AUDIT_LOG"
  else
    echo "[$timestamp] $event" >> "$AUDIT_LOG"
  fi
}

# Check if AGENTS.md changed in this push
AGENTS_MD_CHANGED=0
AGENTS_SHA_CHANGED=0

# Use captured refs from earlier stdin read to check for changes
if [ -n "$LOCAL_SHA" ] && [ -n "$REMOTE_SHA" ]; then
  # Check if AGENTS.md is in the staged changes
  if git diff --cached --name-only "$LOCAL_SHA" 2>/dev/null | grep -q "^docs/AGENTS.md$"; then
    AGENTS_MD_CHANGED=1
  fi
  
  # Check if .agents_verification_sha is in the staged changes
  if git diff --cached --name-only "$LOCAL_SHA" 2>/dev/null | grep -q "^.agents_verification_sha$"; then
    AGENTS_SHA_CHANGED=1
  fi
fi

# Determine if we should verify (not bypassed)
SHOULD_VERIFY=1
if [ "${SKIP_AGENT_VERIFICATION:-}" = "true" ] || [ "${SKIP_AGENT_VERIFICATION:-}" = "1" ]; then
  SHOULD_VERIFY=0
  log_audit "agent_verification_skipped" "SKIP_AGENT_VERIFICATION=${SKIP_AGENT_VERIFICATION}"
  warn "Agent verification skipped (SKIP_AGENT_VERIFICATION=${SKIP_AGENT_VERIFICATION})"
fi

if [ "$SHOULD_VERIFY" -eq 1 ]; then
  # Case 1: AGENTS.md changed but .agents_verification_sha did not
  if [ "$AGENTS_MD_CHANGED" -eq 1 ] && [ "$AGENTS_SHA_CHANGED" -eq 0 ]; then
    fail "docs/AGENTS.md changed but .agents_verification_sha was not regenerated"
    echo ""
    echo "  📋 Remediation steps:"
    echo "     1. Run: scripts/generate-agent-verification-sha.py"
    echo "     2. Stage the generated .agents_verification_sha"
    echo "     3. Commit or amend the current commit"
    echo "     4. Retry push"
    echo ""
    AGENT_VERIFY_ERRORS=$((AGENT_VERIFY_ERRORS + 1))
    log_audit "agent_verification_failed" "AGENTS.md_changed=1 agents_verification_sha_changed=0"
  fi
  
  # Case 2: .agents_verification_sha changed but AGENTS.md did not
  if [ "$AGENTS_SHA_CHANGED" -eq 1 ] && [ "$AGENTS_MD_CHANGED" -eq 0 ]; then
    fail ".agents_verification_sha changed but docs/AGENTS.md was not modified"
    echo ""
    echo "  📋 Remediation steps:"
    echo "     1. Verify docs/AGENTS.md is intentionally unchanged"
    echo "     2. If verification SHA should not have changed:"
    echo "        git reset HEAD .agents_verification_sha"
    echo "        git checkout .agents_verification_sha"
    echo "     3. If AGENTS.md should have changed:"
    echo "        git diff .agents_verification_sha"
    echo "        to review what changed"
    echo "     4. Retry push"
    echo ""
    AGENT_VERIFY_ERRORS=$((AGENT_VERIFY_ERRORS + 1))
    log_audit "agent_verification_failed" "agents_verification_sha_changed=1 AGENTS.md_changed=0"
  fi
  
  # Case 3: Both changed or both unchanged is OK
  if [ "$AGENTS_MD_CHANGED" -eq 1 ] && [ "$AGENTS_SHA_CHANGED" -eq 1 ]; then
    # Verify the script exists and is executable
    if [ ! -f "scripts/generate-agent-verification-sha.py" ]; then
      fail "scripts/generate-agent-verification-sha.py not found"
      AGENT_VERIFY_ERRORS=$((AGENT_VERIFY_ERRORS + 1))
      log_audit "agent_verification_failed" "generation_script_missing"
    else
      # Try to verify the SHA was actually regenerated
      # by running the script in a temp location and comparing
      if command -v python3 >/dev/null 2>&1; then
        TEMP_SHA_FILE=$(mktemp)
        trap "rm -f $TEMP_SHA_FILE" EXIT
        
        # Run script to generate fresh SHA (invoke explicitly via python3, no executable check needed)
        if python3 scripts/generate-agent-verification-sha.py > /dev/null 2>&1; then
          # Compare with staged .agents_verification_sha
          STAGED_SHA=$(git show ":".agents_verification_sha 2>/dev/null | grep "^agent_sha256=" | cut -d= -f2)
          CURRENT_SHA=$(grep "^agent_sha256=" .agents_verification_sha | cut -d= -f2)
          
          if [ "$STAGED_SHA" = "$CURRENT_SHA" ]; then
            pass "Agent definitions and verification SHA in sync"
            log_audit "agent_verification_passed" "AGENTS.md_changed=1 agents_verification_sha_changed=1"
          else
            warn "Staged .agents_verification_sha SHA differs from current regeneration"
            warn "This may indicate AGENTS.md was modified after SHA regeneration"
            log_audit "agent_verification_warning" "staged_sha_differs_from_regenerated"
          fi
        else
          warn "Could not verify agent SHA regeneration (script execution issue)"
          log_audit "agent_verification_warning" "script_execution_failed"
        fi
      else
        pass "Both AGENTS.md and .agents_verification_sha changed (python3 unavailable for verification)"
        log_audit "agent_verification_passed" "AGENTS.md_changed=1 agents_verification_sha_changed=1 python3_unavailable"
      fi
    fi
  elif [ "$AGENTS_MD_CHANGED" -eq 0 ] && [ "$AGENTS_SHA_CHANGED" -eq 0 ]; then
    # Neither changed - this is fine
    pass "No agent definition changes detected"
    log_audit "agent_verification_passed" "no_changes_detected"
  fi
fi

if [ "$AGENT_VERIFY_ERRORS" -gt 0 ]; then
  ERRORS=$((ERRORS + AGENT_VERIFY_ERRORS))
  CHECKS_FAILED=$((CHECKS_FAILED + AGENT_VERIFY_ERRORS))
fi

