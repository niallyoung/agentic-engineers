#!/usr/bin/env bash
# .githooks/pre-commit — SDLC enforcement for agentic-engineers
#
# Enforces (staged files only, fast, commit-time-valuable checks):
#   1. Syntax validation (Python -m py_compile, bash -n, optional shellcheck)
#   2. Secrets detection (API keys, AWS keys, Anthropic/GitHub tokens, client_secret
#      assignments, PEM private-key headers, literal-valued sensitive env vars)
#   3. File permissions (no executable bits on .md/.yaml/.txt/.json/.jsonc)
#
# Additional validations:
#   - Agent frontmatter consistency (model/effort match src/AGENTS.md)
#   - YAML/JSON well-formedness
#   - opencode.jsonc schema validation (when staged)
#   - No --no-verify / SKIP_HOOKS=1 bypass markers in committed code (warning only)
#   - No staged .pyc bytecode
#   - Model registry compliance (scripts/models.py check / is-known)
#
# 2026-08-13 infra consolidation: dropped the former pylint/mypy/contract-
# validation checks (all three were optional and warn-only — they could never
# block a commit, so removing them changes no observable enforcement) and a
# duplicate secret-detection block. See inline NOTEs at each removal site.
#
# Install: git config core.hooksPath .githooks
# Bypass (emergency only): SKIP_HOOKS=1 git commit  (the one documented bypass variable)
#
# Performance targets:
#   - Pre-commit < 3 seconds for typical changes
#   - Only validates modified files (not entire codebase)
#   - Skips expensive checks on non-Python files

set -euo pipefail

# The one documented emergency bypass (document the reason in the commit message).
if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "⚠️  SKIP_HOOKS=1 set — bypassing pre-commit enforcement (emergency only)"
  exit 0
fi

ERRORS=0
WARNINGS=0

fail() {
  printf '%s\n' "❌ $1"
  ERRORS=$((ERRORS + 1))
}

warn() {
  printf '%s\n' "⚠️  $1"
  WARNINGS=$((WARNINGS + 1))
}

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: 3 CORE VALIDATION CHECKS
# ════════════════════════════════════════════════════════════════════════════════

# ── CHECK 1: SYNTAX VALIDATION (Python, Shell) ─────────────────────────────────
echo ""
echo "🔍 CHECK 1: Syntax validation..."

SYNTAX_ERRORS=0

# Python syntax check (py_compile)
STAGED_PYTHON=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$STAGED_PYTHON" ]; then
  for pyfile in $STAGED_PYTHON; do
    [ -f "$pyfile" ] || continue
    if ! python3 -m py_compile "$pyfile" 2>/dev/null; then
      fail "Python syntax error in: $pyfile"
      SYNTAX_ERRORS=$((SYNTAX_ERRORS + 1))
    fi
  done
fi

# Shell syntax check (bash -n)
STAGED_SHELL=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$' || true)
if [ -n "$STAGED_SHELL" ]; then
  for shfile in $STAGED_SHELL; do
    [ -f "$shfile" ] || continue
    if ! bash -n "$shfile" 2>/dev/null; then
      fail "Shell syntax error in: $shfile"
      SYNTAX_ERRORS=$((SYNTAX_ERRORS + 1))
    fi
  done
fi

# Shellcheck if available (optional, but recommended)
if command -v shellcheck >/dev/null 2>&1 && [ -n "$STAGED_SHELL" ]; then
  for shfile in $STAGED_SHELL; do
    [ -f "$shfile" ] || continue
    if ! shellcheck -x "$shfile" 2>/dev/null; then
      warn "Shellcheck warning in: $shfile (non-blocking)"
    fi
  done
fi

if [ "$SYNTAX_ERRORS" -eq 0 ]; then
  echo "✅ Syntax validation passed"
else
  echo "❌ Syntax validation found $SYNTAX_ERRORS error(s)"
fi

# NOTE (2026-08-13 infra consolidation): the former CHECK 2 (pylint) and
# CHECK 3 (mypy) sections are removed. Both were optional (skipped entirely
# when the tool wasn't installed) and warn-only even when they ran — neither
# `warn()` call ever touched $ERRORS, so they could never block a commit.
# They added real wall-clock cost (mypy in particular) for zero enforcement
# value, and duplicated `make lint` conceptually. See docs/CONTRIBUTING for
# the current lint story.

# ── CHECK 2: SECRETS DETECTION ─────────────────────────────────────────────────
echo ""
echo "🔍 CHECK 2: Secrets detection..."

SECRETS_ERRORS=0

# Scan the STAGED content of every added/copied/modified/renamed file.
#   - --diff-filter=ACMR: renamed files (R) carry their content into the commit and
#     must be scanned like any other (ACM missed them).
#   - -z / read -d '': filenames are NUL-separated, so names with spaces (or other
#     odd characters) are scanned as one file instead of being word-split into
#     non-existent paths that silently skip the check.
#   - Binary files are skipped by content (grep -I), not by file(1) wording: file(1)
#     reports executable shell scripts as "executable", which used to exempt them.
SECRET_TMP=$(mktemp)
# Optional opening quote, single or double. (The old '["\x27]' form never matched a
# single quote: inside a bracket expression \x27 is four literal characters.)
Q="[\"']?"
secret_hit() {   # secret_hit <file> <message>
  fail "$2 in $1"
  SECRETS_ERRORS=$((SECRETS_ERRORS + 1))
}

while IFS= read -r -d '' f; do
  [ -n "$f" ] || continue
  git show ":$f" > "$SECRET_TMP" 2>/dev/null || continue   # e.g. submodule entry
  grep -Iq . "$SECRET_TMP" 2>/dev/null || continue         # binary or empty

  # Generic: credential-ish name assigned a long literal.
  if grep -qiE "(api_key|secret_key|private_key|password|token)[[:space:]]*[:=][[:space:]]*${Q}[A-Za-z0-9/+]{20,}" "$SECRET_TMP"; then
    secret_hit "$f" "Possible secret detected (review before committing)"
  fi

  # AWS access key IDs.
  if grep -qE 'AKIA[0-9A-Z]{16}' "$SECRET_TMP"; then
    secret_hit "$f" "AWS access key pattern detected"
  fi

  # Anthropic API keys (sk-ant-...) and GitHub tokens (ghp_/gho_/ghu_/ghs_/ghr_,
  # and fine-grained github_pat_...).
  if grep -qE 'sk-ant-[A-Za-z0-9_-]{20,}' "$SECRET_TMP"; then
    secret_hit "$f" "Anthropic API key pattern (sk-ant-) detected"
  fi
  if grep -qE '(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})' "$SECRET_TMP"; then
    secret_hit "$f" "GitHub token pattern detected"
  fi

  # PEM private-key headers (RSA/EC/DSA/OPENSSH/ENCRYPTED/PKCS#8 ...).
  if grep -qE -e '-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----' "$SECRET_TMP"; then
    secret_hit "$f" "PEM private key header detected"
  fi

  # client_secret assigned a literal (also JSON "client_secret": "..."). A reference
  # such as `${{ secrets.X }}` or os.environ[...] is the SAFE pattern: not flagged.
  if grep -vE '(secrets\.|env\.|vars\.|\$\{|environ|getenv|auth_env|setenv|delenv)' "$SECRET_TMP" \
       | grep -qiE "client_?secret${Q}[[:space:]]*[:=][[:space:]]*${Q}[A-Za-z0-9/_+-]{16,}"; then
    secret_hit "$f" "client_secret assigned a literal value"
  fi

  # Explicit secret markers (env vars assigned an inline literal value).
  # NOTE: We only flag an *assignment to a literal* (e.g. GITHUB_TOKEN="ghp_...").
  # A bare reference is the SAFE pattern and must NOT be flagged — e.g.
  # `${{ secrets.GITHUB_TOKEN }}`, `auth_env: GITHUB_TOKEN`, `os.environ["GITHUB_TOKEN"]`,
  # or documentation mentioning the variable name. Matching the bare name produced
  # false positives on safe CI config and on the token-in-gitconfig security docs.
  if grep -vE '(secrets\.|env\.|vars\.|\$\{|environ|getenv|auth_env|setenv|delenv)' "$SECRET_TMP" \
       | grep -qE "(OPENAI_API_KEY|ANTHROPIC_API_KEY|GITHUB_TOKEN|AWS_SECRET[A-Z_]*)[[:space:]]*[:=][[:space:]]*${Q}[A-Za-z0-9/_+-]{16,}"; then
    secret_hit "$f" "Sensitive environment variable assigned a literal value (use .env or a secrets manager)"
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null)
rm -f "$SECRET_TMP"

if [ "$SECRETS_ERRORS" -eq 0 ]; then
  echo "✅ Secrets detection passed"
else
  echo "❌ Secrets detection found $SECRETS_ERRORS issue(s)"
fi

# NOTE (2026-08-13 infra consolidation): the former CHECK 5 (contract
# validation) is removed — a narrow grep heuristic for @property/@staticmethod
# decorator mismatches that was warn-only ($CONTRACT_ERRORS was never added
# to $ERRORS) and never blocked a commit.

# ── CHECK 3: FILE PERMISSIONS (no executable bits on .md/.yaml/.txt) ──────────
echo ""
echo "🔍 CHECK 3: File permissions..."

PERMS_ERRORS=0

# Check that documentation and config files are not executable
for ext in "md" "yaml" "yml" "txt" "json" "jsonc"; do
  STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.$ext$" || true)
  
  for docfile in $STAGED_DOCS; do
    [ -f "$docfile" ] || continue
    
    # Check if file is executable
    if [ -x "$docfile" ]; then
      fail "Documentation/config file should not be executable: $docfile"
      fail "  Fix: chmod -x $docfile"
      PERMS_ERRORS=$((PERMS_ERRORS + 1))
    fi
  done
done

if [ "$PERMS_ERRORS" -eq 0 ]; then
  echo "✅ File permissions check passed"
else
  echo "❌ File permissions check found $PERMS_ERRORS issue(s)"
  ERRORS=$((ERRORS + PERMS_ERRORS))
fi

echo ""
echo "════════════════════════════════════════════════════════════════════════════════"
echo ""
# NOTE (hook cleanup): the orchestration/scripts/ and orchestration/config/*.cron
# re-introduction checks that used to live here are removed. orchestration/ no
# longer exists; the re-introduction guard is scripts/validate-spec-constraints.py.

# ─── Section: Agent frontmatter consistency check ───────────────────────────
# Validate that src/agents/*-agent.md frontmatter model/effort fields
# match the canonical values in src/AGENTS.md.
# This prevents silent drift between source files and the canonical table.

validate_agent_frontmatter() {
	local repo_root="$1"
	local agents_md="$repo_root/src/AGENTS.md"
	local src_agents="$repo_root/src/agents"
	local errors=0
	
	# Source shared lib for extract_fm, parse_agents_md, lookup_agent_metadata.
	# Prefer the committing repo's copy, fall back to this hook's own repo. Test for
	# the file first: sourcing a missing file aborts a `set -e` shell on some bash
	# versions instead of reaching the `||` fallback, which silently killed the hook
	# (and with it the model registry checks below) in repos without renderer/.
	local render_lib="$repo_root/renderer/lib/render-lib.sh"
	[ -f "$render_lib" ] || render_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/renderer/lib/render-lib.sh"
	if [ ! -f "$render_lib" ]; then
		echo "⚠️  pre-commit: render-lib.sh not found — skipping frontmatter check" >&2
		return 0
	fi
	# shellcheck source=../renderer/lib/render-lib.sh
	source "$render_lib" 2>/dev/null || {
		echo "⚠️  pre-commit: could not source render-lib.sh — skipping frontmatter check" >&2
		return 0
	}
	
	# Parse canonical metadata into a temp file
	local agents_map
	agents_map=$(mktemp)
	trap "rm -f '$agents_map'" RETURN
	
	if ! parse_agents_md "$agents_md" > "$agents_map" 2>/dev/null; then
		echo "⚠️  pre-commit: could not parse $agents_md — skipping frontmatter check" >&2
		return 0
	fi
	
	if [ ! -s "$agents_map" ]; then
		echo "⚠️  pre-commit: $agents_md yielded no agent entries — skipping frontmatter check" >&2
		return 0
	fi
	
	# Check each staged agent file
	for agent_file in "$src_agents"/*-agent.md; do
		[ -f "$agent_file" ] || continue
		
		agent_name=$(basename "$agent_file" "-agent.md")
		
		# Only check staged files (files that are being committed)
		if ! git diff --cached --name-only | grep -q "src/agents/${agent_name}-agent.md"; then
			continue
		fi
		
		# Get frontmatter model and effort
		fm_model=$(extract_fm "$agent_file" "model" 2>/dev/null || true)
		fm_effort=$(extract_fm "$agent_file" "effort" 2>/dev/null || true)
		
		# Get canonical values
		canonical=$(lookup_agent_metadata "$agent_name" "$agents_map")
		if [ -z "$canonical" ]; then
			# Agent not in src/AGENTS.md — skip (may be a new agent being added)
			continue
		fi

		canonical_model=$(echo "$canonical" | cut -d'|' -f1)
		canonical_effort=$(echo "$canonical" | cut -d'|' -f2)

		# Compare model
		if [ -n "$fm_model" ] && [ "$fm_model" != "$canonical_model" ]; then
			echo "❌ pre-commit: $agent_file model mismatch" >&2
			echo "   frontmatter: model: $fm_model" >&2
			echo "   src/AGENTS.md: model: $canonical_model" >&2
			echo "   Fix: update frontmatter or src/AGENTS.md to match" >&2
			errors=$((errors + 1))
		fi

		# Compare effort
		if [ -n "$fm_effort" ] && [ "$fm_effort" != "$canonical_effort" ]; then
			echo "❌ pre-commit: $agent_file effort mismatch" >&2
			echo "   frontmatter: effort: $fm_effort" >&2
			echo "   src/AGENTS.md: effort: $canonical_effort" >&2
			echo "   Fix: update frontmatter or src/AGENTS.md to match" >&2
			errors=$((errors + 1))
		fi
	done
	
	return $errors
}

# Run validation (only if src/AGENTS.md and src/agents/ exist)
REPO_ROOT_HOOK=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [ -f "$REPO_ROOT_HOOK/src/AGENTS.md" ] && [ -d "$REPO_ROOT_HOOK/src/agents" ]; then
	if ! validate_agent_frontmatter "$REPO_ROOT_HOOK"; then
		echo "" >&2
		echo "💡 To bypass this check (emergency only): SKIP_HOOKS=1 git commit" >&2
		ERRORS=$((ERRORS + 1))
	fi
fi
# ─── End: Agent frontmatter consistency check ────────────────────────────────

# NOTE (2026-08-13 infra consolidation): a duplicate secret-detection block
# used to live here — the exact same api_key/secret_key/AWS-key patterns as
# CHECK 2 above, re-run against the same staged files. CHECK 2 is a superset
# (it also catches literal-valued sensitive env vars), so the duplicate is
# removed rather than merged.

# ── 3. YAML well-formedness ────────────────────────────────────────────────────
if command -v python3 >/dev/null 2>&1; then
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yaml|yml)$' || true); do
    [ -f "$f" ] || continue
    if ! git show ":$f" 2>/dev/null | python3 -c "import sys,yaml; yaml.safe_load(sys.stdin)" 2>/dev/null; then
      fail "Invalid YAML: $f"
    fi
  done

  # JSON well-formedness
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json(c)?$' || true); do
    [ -f "$f" ] || continue
    # Strip JSONC comments before parsing
    if ! git show ":$f" 2>/dev/null | python3 -c "
import sys, re, json
content = sys.stdin.read()
# Strip // comments (not inside strings)
content = re.sub(r'(?m)//.*$', '', content)
# Strip /* */ comments
content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
json.loads(content)
" 2>/dev/null; then
      warn "Possible JSON syntax issue in $f (JSONC comments stripped before check)"
    fi
  done
fi

# ─── Section: OpenCode harness config validation ─────────────────────────────
# Security-critical: opencode.jsonc errors have broken the OpenCode CLI twice.
# The validator (scripts/validate_opencode_config.py) documents each rule it
# enforces, and is the reference for what a valid config looks like. When staged, run
# the full schema validator (scripts/validate_opencode_config.py) and BLOCK the
# commit on any ERROR finding. Warnings are surfaced but do not block.
#
# Bypass: SKIP_HOOKS=1 git commit  (emergency only; skips the whole hook)
if git diff --cached --name-only | grep -qE '^opencode\.jsonc$'; then
  if [ -f "$REPO_ROOT_HOOK/scripts/validate_opencode_config.py" ] && command -v python3 >/dev/null 2>&1; then
    echo "🔒 Validating staged opencode.jsonc…"
    # Validate the STAGED content (not the working tree) so amendments are caught.
    staged_tmp="$(mktemp -t opencode.jsonc.staged.XXXXXX)"
    trap "rm -f '$staged_tmp'" EXIT
    git show ":opencode.jsonc" > "$staged_tmp" 2>/dev/null || true
    if ! ( cd "$REPO_ROOT_HOOK" && python3 scripts/validate_opencode_config.py "$staged_tmp" ); then
      fail "opencode.jsonc validation failed — see errors above; run 'python3 scripts/validate_opencode_config.py opencode.jsonc' to reproduce"
    fi
  else
    warn "opencode.jsonc staged but validator not available — install scripts/validate_opencode_config.py"
  fi
fi
# ─── End: OpenCode harness config validation ─────────────────────────────────

# ── 4. No bypass markers in committed code ────────────────────────────────────
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|sh|bash)$' || true); do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qE '(--no-verify|SKIP_HOOKS=1)'; then
    warn "$f contains --no-verify or SKIP_HOOKS=1 — ensure this is intentional"
  fi
done

# NOTE: versioning is CI/CD-driven (git tags auto-created by
# mathieudutour/github-tag-action on merge to main) — there is no
# version-manager step in this hook. (2026-08-13: removed a ~60-line inert
# commented-out block that referenced a version-manager skill deleted well
# before this repo's current skill roster.)

# ─── Section: Bytecode Check ───────────────────────────────────────────────────
# Reject staged .pyc files (bytecode must never be version controlled).
# The former timestamp-mismatch and "test without implementation" sub-checks are
# removed: the first only ever warned, the second could only warn or fail on a
# file that had just been staged and so always existed.

STAGED_PYC=$(git diff --cached --name-only | grep '\.pyc$' || true)
if [ -n "$STAGED_PYC" ]; then
    echo ""
    while IFS= read -r f; do
        fail "Staged .pyc file detected (bytecode must not be version controlled): $f"
        fail "  Fix: git reset HEAD -- '$f' && echo '*.pyc' >> .gitignore"
    done <<< "$STAGED_PYC"
fi

# ─── End: Bytecode Check ───────────────────────────────────────────────────────

# ─── Section: Model Registry Enforcement ─────────────────────────────────────────
# config/models.yaml is the single source of truth for model pins (docs/SPEC.md,
# Model Pin Change; invariants I1-I6; docs/decisions/ADR-model-pin-registry.md).
# This hook holds NO model list and NO version allowlist: every decision is made by
# scripts/models.py, so adding or re-pinning a model never needs a hook edit (I6).
#
#   1. Staged src/agents/*-agent.md `model:` must be a known, non-retired registry ID
#      (`models.py is-known`; hyphenated render forms are rejected as source IDs).
#   2. When registry-related files are staged, `models.py check` must pass: registry
#      shape, fallback policy, per-family min_pin floor, pin_history consistency, and
#      generated targets current (stale targets => run `models.py sync`).
#
# The checks run against a snapshot of the INDEX (git checkout-index into a temp
# dir, passed as --root), so exactly what is staged is validated, and it works in
# scratch repos. A missing PyYAML is a hard failure with a clear
# message, never a silent pass.
#
# Philosophy: POSITIVE ENFORCEMENT — models are pinned by choice in the registry.

echo ""
echo "🔒 Validating model registry compliance..."

MODEL_REG_TOP=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# models.py lives next to this hook's repo; when the hook is a copy (e.g. .git/hooks/),
# fall back to the committing repo's own scripts/.
MODELS_PY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/models.py"
[ -f "$MODELS_PY" ] || MODELS_PY="$MODEL_REG_TOP/scripts/models.py"
MODEL_ERRORS=0

STAGED_MODEL_REL=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD \
    | grep -E '^(config/models\.yaml|config/FRAMEWORK-MANIFEST\.yaml|src/AGENTS\.md|src/agents/[^/]+-agent\.md|\.githooks/LOCKED_MODELS\.sh|docs/MODELS\.md|\.agents_verification_sha|scripts/models\.py)$' || true)

# The model checks run against a snapshot of the INDEX (what is about to be
# committed), not the working tree, so unstaged edits can neither mask a staged
# error nor cause a spurious failure. If the snapshot cannot be taken (e.g. an
# unmerged index) the checks fall back to the working tree and say so.
MODEL_ROOT="$MODEL_REG_TOP"
MODEL_SNAPSHOT=""
if [ -n "$STAGED_MODEL_REL" ]; then
    MODEL_SNAPSHOT=$(mktemp -d 2>/dev/null || true)
    if [ -n "$MODEL_SNAPSHOT" ] && git checkout-index -a --prefix="$MODEL_SNAPSHOT/" >/dev/null 2>&1; then
        MODEL_ROOT="$MODEL_SNAPSHOT"
    else
        warn "could not snapshot the index for model checks; validating the working tree instead"
    fi
fi

if [ -z "$STAGED_MODEL_REL" ]; then
    echo "✅ Model registry check skipped (no registry-related files staged)"
elif [ ! -f "$MODEL_ROOT/config/models.yaml" ]; then
    # Only reachable for a tree without a registry; staged registry deletion is caught here too.
    fail "model registry violation: config/models.yaml is missing but registry-related files are staged"
    MODEL_ERRORS=$((MODEL_ERRORS + 1))
elif [ ! -f "$MODELS_PY" ]; then
    fail "model registry violation: $MODELS_PY not found; cannot validate models"
    MODEL_ERRORS=$((MODEL_ERRORS + 1))
elif ! python3 -c 'import yaml' >/dev/null 2>&1; then
    fail "model registry violation: python3 has no PyYAML, so config/models.yaml cannot be validated"
    echo "   Fix: python3 -m pip install pyyaml   (or SKIP_HOOKS=1 with a documented reason)"
    MODEL_ERRORS=$((MODEL_ERRORS + 1))
else
    # 1. Staged source agents: model must be a known registry ID. One filename per
    #    line (IFS= read -r), so names containing spaces are checked as one file
    #    instead of being word-split into non-existent paths that skip the check.
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        staged_content=$(git show ":$file" 2>/dev/null) || continue   # deleted
        model=$( { printf '%s\n' "$staged_content" | grep -E '^model:[[:space:]]*' | head -1 \
                   | awk '{print $2}' | tr -d "\"'"; } || true)
        [ -n "$model" ] || continue   # no model field: not a full agent file
        if ! python3 "$MODELS_PY" --root "$MODEL_ROOT" is-known "$model" >/dev/null 2>&1; then
            fail "model registry violation: Model not in the registry: $file"
            echo "   Model: $model"
            echo "   Known models: python3 scripts/models.py list-ids"
            echo "   To change a role's pin: edit config/models.yaml, then run"
            echo "   python3 scripts/models.py sync (see docs/SPEC.md, Model Pin Change)"
            MODEL_ERRORS=$((MODEL_ERRORS + 1))
        fi
    done < <(printf '%s\n' "$STAGED_MODEL_REL" | grep -E '^src/agents/' || true)

    # 2. Registry shape, floor, history and generated-target consistency.
    CHECK_RC=0
    CHECK_OUT=$(python3 "$MODELS_PY" --root "$MODEL_ROOT" check 2>&1) || CHECK_RC=$?
    if [ "$CHECK_RC" -ne 0 ]; then
        fail "model registry violation: models.py check failed"
        printf '%s\n' "$CHECK_OUT" | sed 's/^/   /'
        MODEL_ERRORS=$((MODEL_ERRORS + 1))
    fi
    SYNC_RC=0
    SYNC_OUT=$(python3 "$MODELS_PY" --root "$MODEL_ROOT" sync --check 2>&1) || SYNC_RC=$?
    if [ "$SYNC_RC" -ne 0 ] && [ "$CHECK_RC" -eq 0 ]; then
        fail "model registry violation: generated targets are stale; run python3 scripts/models.py sync"
        printf '%s\n' "$SYNC_OUT" | sed 's/^/   /'
        MODEL_ERRORS=$((MODEL_ERRORS + 1))
    fi
fi
[ -z "$MODEL_SNAPSHOT" ] || rm -rf "$MODEL_SNAPSHOT"

if [ "$MODEL_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ pre-commit: $MODEL_ERRORS model registry violation(s) found"
    ERRORS=$((ERRORS + MODEL_ERRORS))
elif [ -n "$STAGED_MODEL_REL" ]; then
    echo "✅ Model registry check passed"
fi

# ─── End: Model Registry Enforcement ─────────────────────────────────────────────

