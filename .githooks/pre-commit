echo ""
echo "🔒 Validating queue path centralization..."

# ─── Section: Model Naming Compliance Enforcement ────────────────────────────────
# SPEC locked: 2026-05-26 (docs/SPEC.md - Model Naming Architecture)
#
# Enforcement: Model naming is PERMANENTLY LOCKED via:
#   1. Source agents MUST use canonical format: claude-{variant}-\d+\.\d+ (DOTS)
#   2. NO GPT models allowed anywhere
#   3. NO unversioned models (claude-opus without -4.7)
#   4. Tests validate all renderers transform correctly per-harness
#
# Rationale: Model naming has broken repeatedly; this is non-negotiable.
# Philosophy: POSITIVE ENFORCEMENT — we enforce locked models by choice, not forbidden patterns.
#

echo ""
echo "🔒 Validating model naming compliance (LOCKED models)..."

# Source locked models configuration
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/LOCKED_MODELS.sh
source "$HOOKS_DIR/LOCKED_MODELS.sh"

MODEL_ERRORS=0

# Validate source agents use models from LOCKED_MODELS
STAGED_MODEL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|py|yaml|yml)$' || true)
for file in $STAGED_MODEL_FILES; do
    [ -f "$file" ] || continue
    
    # Only check source agent files
    if [[ "$file" != src/agents/* ]]; then
        continue
    fi
    
    # Extract model from staged content (from frontmatter)
    staged_content=$(git show ":$file" 2>/dev/null)
    model=$(echo "$staged_content" | grep -E '^model:\s*' | head -1 | awk '{print $2}' | tr -d '"'"'"'')
    
    if [ -z "$model" ]; then
        # No model field found — skip (might not be a full agent file)
        continue
    fi
    
    # Check if model is in locked set
    if ! is_model_locked "$model"; then
        fail "❌ Model not in locked set: $file"
        fail "   Model: $model"
        fail "   Locked models (approved choices):"
        for locked_model in "${LOCKED_MODELS[@]}"; do
            fail "     - $locked_model"
        done
        fail "   To request a model change, contact the Orchestrator"
        fail "   → Include: agent name and reason for the change"
        MODEL_ERRORS=$((MODEL_ERRORS + 1))
    fi
done

if [ "$MODEL_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ pre-commit: $MODEL_ERRORS model compliance violation(s) found"
    fail "Models are LOCKED by choice. See .githooks/LOCKED_MODELS.sh for approved models"
    ERRORS=$((ERRORS + MODEL_ERRORS))
fi

# ─── End: Model Naming Compliance Enforcement ────────────────────────────────

QUEUE_ERRORS=0

# Get all staged files
STAGED_QUEUE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|json|yaml|yml|jsonc)$' || true)

for file in $STAGED_QUEUE_FILES; do
    [ -f "$file" ] || continue
    
     # Skip exceptions: queue_compat.py, queue_path_validator.py (contains legacy patterns for validation), _archive/, and tests/
     if [[ "$file" == *"queue_compat.py"* ]] || [[ "$file" == *"queue_path_validator.py"* ]] || [[ "$file" == *"_archive"* ]] || [[ "$file" == *"test_"* ]]; then
         continue
     fi
    
    # Check for legacy queue paths in staged content
    
    # Block: ~/.copilot/queue (except exceptions)
    if git show ":$file" 2>/dev/null | grep -q "\.copilot/queue"; then
        if [[ "$file" != *"queue_compat.py"* ]] && [[ "$file" != *"_archive"* ]]; then
            fail "Legacy queue path found in $file: ~/.copilot/queue"
            fail "  → Use ~/.agentic-engineers/ instead (see docs/SPEC.md)"
            QUEUE_ERRORS=$((QUEUE_ERRORS + 1))
        fi
    fi
    
    # Block: ~/.claude/queue (except exceptions)
    if git show ":$file" 2>/dev/null | grep -q "\.claude/queue"; then
        if [[ "$file" != *"queue_compat.py"* ]] && [[ "$file" != *"_archive"* ]]; then
            fail "Legacy queue path found in $file: ~/.claude/queue"
            fail "  → Use ~/.agentic-engineers/ instead (see docs/SPEC.md)"
            QUEUE_ERRORS=$((QUEUE_ERRORS + 1))
        fi
    fi
    
    # Block: artifacts/queue (except queue_compat.py and _archive/)
    if git show ":$file" 2>/dev/null | grep -q "artifacts/queue"; then
        if [[ "$file" != *"queue_compat.py"* ]] && [[ "$file" != *"_archive"* ]]; then
            fail "Legacy queue path found in $file: artifacts/queue"
            fail "  → Use ~/.agentic-engineers/ instead (see docs/SPEC.md)"
            QUEUE_ERRORS=$((QUEUE_ERRORS + 1))
        fi
    fi
done

if [ "$QUEUE_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ pre-commit: $QUEUE_ERRORS queue path violation(s) found"
    ERRORS=$((ERRORS + QUEUE_ERRORS))
fi

# ─── End: Queue Path Centralization Enforcement ────────────────────────────────

# ─── DELEGATE/HANDBACK Protocol Validation ─────────────────────────────────────
# Validates DELEGATE and HANDBACK YAML files committed to ensure protocol compliance:
#   - DELEGATE: requires task_id (YYYY-MM-DD-kebab format), valid role, plan field
#   - HANDBACK: requires task_id, valid status, quality_score, tokens_in
#   - Both: detect hardcoded secrets/passwords
#   - Both: support .yaml and .yml extensions
#
# Bypass: BYPASS_HOOK_VALIDATION=true (for emergency) or SKIP_HOOKS=1

echo ""
echo "🔐 Validating DELEGATE/HANDBACK protocol files..."

PROTOCOL_ERRORS=0

# Check bypass flag first
if [ "${BYPASS_HOOK_VALIDATION:-false}" = "true" ]; then
  echo "⚠️  pre-commit: BYPASS_HOOK_VALIDATION=true — skipping DELEGATE/HANDBACK validation" >&2
else
  # Get all staged YAML/YML files
  STAGED_YAML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yaml|yml)$' || true)
  
  for file in $STAGED_YAML_FILES; do
    [ -f "$file" ] || continue
    
    # Get file content from staging area
    file_content=$(git show ":$file" 2>/dev/null) || continue
    
    # Skip if not a DELEGATE or HANDBACK file
    if ! echo "$file_content" | grep -q "^handoff_type:\s*"; then
      continue
    fi
    
    handoff_type=$(echo "$file_content" | grep "^handoff_type:" | head -1 | sed 's/^handoff_type:\s*//;s/\s*$//' | xargs)
    
    case "$handoff_type" in
      DELEGATE)
        # Validate DELEGATE protocol
        task_id=$(echo "$file_content" | grep "^task_id:" | head -1 | sed 's/^task_id:\s*//;s/\s*$//' | xargs || true)
        role=$(echo "$file_content" | grep "^role:" | head -1 | sed 's/^role:\s*//;s/\s*$//' | xargs || true)
        plan=$(echo "$file_content" | grep "^plan:" | head -1 || true)
        
        # Check for secret patterns
        if echo "$file_content" | grep -qiE "^\s*(password|api_key|secret|token|credential):\s*"; then
          fail "🔓 SECURITY: DELEGATE file $file contains secret field(s) — remove before committing"
          fail "   → Use context/notes to reference secrets, never hardcode"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check task_id presence
        if [ -z "$task_id" ]; then
          fail "DELEGATE $file: missing required field 'task_id'"
          fail "   → Format: YYYY-MM-DD-kebab-case (e.g., 2026-05-16-impl-feature-x)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$task_id" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$'; then
          fail "DELEGATE $file: invalid task_id format '$task_id'"
          fail "   → Must be: YYYY-MM-DD-kebab-case (e.g., 2026-05-16-impl-feature)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check role validity
        if [ -z "$role" ]; then
          fail "DELEGATE $file: missing required field 'role'"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$role" | grep -qE '^(engineer|senior_engineer|lead_engineer|principal_engineer|security_engineer|quality_engineer|model_engineer)$'; then
          fail "DELEGATE $file: invalid role '$role'"
          fail "   → Valid roles: engineer, senior_engineer, lead_engineer, principal_engineer,"
          fail "                  security_engineer, quality_engineer, model_engineer"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check plan presence
        if [ -z "$plan" ]; then
          fail "DELEGATE $file: missing required field 'plan'"
          fail "   → plan must be a non-empty list"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        ;;
        
      HANDBACK)
        # Validate HANDBACK protocol
        task_id=$(echo "$file_content" | grep "^task_id:" | head -1 | sed 's/^task_id:\s*//;s/\s*$//' | xargs || true)
        status=$(echo "$file_content" | grep "^status:" | head -1 | sed 's/^status:\s*//;s/\s*$//' | xargs || true)
        quality_score=$(echo "$file_content" | grep "^quality_score:" | head -1 | sed 's/^quality_score:\s*//;s/\s*$//' | xargs || true)
        tokens_in=$(echo "$file_content" | grep "^tokens_in:" | head -1 | sed 's/^tokens_in:\s*//;s/\s*$//' | xargs || true)
        
        # Check for secret patterns
        if echo "$file_content" | grep -qiE "^\s*(password|api_key|secret|token|credential):\s*"; then
          fail "🔓 SECURITY: HANDBACK file $file contains secret field(s) — remove before committing"
          fail "   → Use notes field to reference, never hardcode"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check task_id
        if [ -z "$task_id" ]; then
          fail "HANDBACK $file: missing required field 'task_id'"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check status validity
        if [ -z "$status" ]; then
          fail "HANDBACK $file: missing required field 'status'"
          fail "   → Valid statuses: complete, failed, partial, blocked"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$status" | grep -qE '^(complete|failed|partial|blocked)$'; then
          fail "HANDBACK $file: invalid status '$status'"
          fail "   → Valid statuses: complete, failed, partial, blocked"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check quality_score
        if [ -z "$quality_score" ]; then
          fail "HANDBACK $file: missing required field 'quality_score'"
          fail "   → Must be numeric (0-100)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        
        # Check tokens_in
        if [ -z "$tokens_in" ]; then
          fail "HANDBACK $file: missing required field 'tokens_in'"
          fail "   → Must be numeric"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        ;;
    esac
  done
  
  if [ "$PROTOCOL_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ pre-commit: $PROTOCOL_ERRORS DELEGATE/HANDBACK validation error(s) found"
    ERRORS=$((ERRORS + PROTOCOL_ERRORS))
  else
    # Check if any DELEGATE/HANDBACK files were validated
    protocol_file_count=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yaml|yml)$' || true | while read -r f; do
      content=$(git show ":$f" 2>/dev/null)
      if echo "$content" | grep -q "^handoff_type:"; then
        echo "1"
      fi
    done | wc -l)
    
    if [ "$protocol_file_count" -gt 0 ]; then
      echo "✅ DELEGATE/HANDBACK validation passed ($protocol_file_count protocol file(s) validated)"
    fi
  fi
fi

# ─── End: DELEGATE/HANDBACK Protocol Validation ────────────────────────────────

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "❌ pre-commit: $ERRORS violation(s) found. Fix issues and re-commit."
  echo "   Bypass for emergency (document reason in commit msg):"
  echo "   → SKIP_HOOKS=1 git commit (bypasses all checks)"
  echo "   → BYPASS_HOOK_VALIDATION=true git commit (bypasses only DELEGATE/HANDBACK)"
  exit 1
fi

echo "✅ pre-commit: all checks passed"
exit 0
