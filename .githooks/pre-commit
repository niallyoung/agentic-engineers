#!/usr/bin/env bash
# .githooks/pre-commit — SDLC enforcement for agentic-engineers
#
# Enforces (staged files only, fast, commit-time-valuable checks):
#   1. Syntax validation (Python -m py_compile, bash -n, optional shellcheck)
#   2. Secrets detection (API keys, AWS keys, literal-valued sensitive env vars)
#   3. File permissions (no executable bits on .md/.yaml/.txt/.json/.jsonc)
#
# Additional validations:
#   - SPEC constraints (no external scripts/cron in orchestration/ paths)
#   - Agent frontmatter consistency (model/effort match src/AGENTS.md)
#   - YAML/JSON well-formedness
#   - opencode.jsonc schema validation (when staged)
#   - No --no-verify / SKIP_HOOKS=1 bypass markers in committed code (warning only)
#   - Source file integrity (no orphaned bytecode, no missing test sources)
#   - Model naming compliance (LOCKED models)
#   - DELEGATE/HANDBACK protocol validation
#
# 2026-08-13 infra consolidation: dropped the former pylint/mypy/contract-
# validation checks (all three were optional and warn-only — they could never
# block a commit, so removing them changes no observable enforcement) and a
# duplicate secret-detection block. See inline NOTEs at each removal site.
#
# Install: git config core.hooksPath .githooks
# Bypass (emergency only): SKIP_HOOKS=1 git commit
#
# Performance targets:
#   - Pre-commit < 3 seconds for typical changes
#   - Only validates modified files (not entire codebase)
#   - Skips expensive checks on non-Python files

set -euo pipefail

# Allow emergency bypass with explicit env var (must be documented in commit msg)
# Also support GIT_SKIP_HOOKS for consistency with pre-push
if [ "${SKIP_HOOKS:-}" = "1" ] || [ "${GIT_SKIP_HOOKS:-}" = "1" ]; then
  echo "⚠️  SKIP_HOOKS=1 or GIT_SKIP_HOOKS=1 set — bypassing pre-commit enforcement (emergency only)"
  exit 0
fi

ERRORS=0
WARNINGS=0

fail() {
  echo "❌ $1"
  ERRORS=$((ERRORS + 1))
}

warn() {
  echo "⚠️  $1"
  WARNINGS=$((WARNINGS + 1))
}

# ════════════════════════════════════════════════════════════════════════════════
# SECTION: 3 CORE VALIDATION CHECKS
# ════════════════════════════════════════════════════════════════════════════════

# ── CHECK 1: SYNTAX VALIDATION (Python, Shell) ─────────────────────────────────
echo ""
echo "🔍 CHECK 1: Syntax validation..."

SYNTAX_ERRORS=0

# Python syntax check (py_compile)
STAGED_PYTHON=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$STAGED_PYTHON" ]; then
  for pyfile in $STAGED_PYTHON; do
    [ -f "$pyfile" ] || continue
    if ! python3 -m py_compile "$pyfile" 2>/dev/null; then
      fail "Python syntax error in: $pyfile"
      SYNTAX_ERRORS=$((SYNTAX_ERRORS + 1))
    fi
  done
fi

# Shell syntax check (bash -n)
STAGED_SHELL=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$' || true)
if [ -n "$STAGED_SHELL" ]; then
  for shfile in $STAGED_SHELL; do
    [ -f "$shfile" ] || continue
    if ! bash -n "$shfile" 2>/dev/null; then
      fail "Shell syntax error in: $shfile"
      SYNTAX_ERRORS=$((SYNTAX_ERRORS + 1))
    fi
  done
fi

# Shellcheck if available (optional, but recommended)
if command -v shellcheck >/dev/null 2>&1 && [ -n "$STAGED_SHELL" ]; then
  for shfile in $STAGED_SHELL; do
    [ -f "$shfile" ] || continue
    if ! shellcheck -x "$shfile" 2>/dev/null; then
      warn "Shellcheck warning in: $shfile (non-blocking)"
    fi
  done
fi

if [ "$SYNTAX_ERRORS" -eq 0 ]; then
  echo "✅ Syntax validation passed"
else
  echo "❌ Syntax validation found $SYNTAX_ERRORS error(s)"
fi

# NOTE (2026-08-13 infra consolidation): the former CHECK 2 (pylint) and
# CHECK 3 (mypy) sections are removed. Both were optional (skipped entirely
# when the tool wasn't installed) and warn-only even when they ran — neither
# `warn()` call ever touched $ERRORS, so they could never block a commit.
# They added real wall-clock cost (mypy in particular) for zero enforcement
# value, and duplicated `make lint` conceptually. See docs/CONTRIBUTING for
# the current lint story.

# ── CHECK 2: SECRETS DETECTION ─────────────────────────────────────────────────
echo ""
echo "🔍 CHECK 2: Secrets detection..."

SECRETS_ERRORS=0

# Scan staged files for common secret patterns
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

for f in $STAGED_FILES; do
  [ -f "$f" ] || continue
  # Skip binary files
  if file "$f" 2>/dev/null | grep -qE '(binary|image|executable)'; then continue; fi

  # Check for common secret patterns
  if git show ":$f" 2>/dev/null | grep -qiE '(api_key|secret_key|private_key|password|token)\s*[:=]\s*["\x27]?[A-Za-z0-9/+]{20,}'; then
    fail "Possible secret detected in $f — review before committing"
    SECRETS_ERRORS=$((SECRETS_ERRORS + 1))
  fi

  # Check for AWS keys
  if git show ":$f" 2>/dev/null | grep -qE 'AKIA[0-9A-Z]{16}'; then
    fail "AWS access key pattern detected in $f"
    SECRETS_ERRORS=$((SECRETS_ERRORS + 1))
  fi

  # Check for explicit secret markers (env vars assigned an inline literal value).
  # NOTE: We only flag an *assignment to a literal* (e.g. GITHUB_TOKEN="ghp_...").
  # A bare reference is the SAFE pattern and must NOT be flagged — e.g.
  # `${{ secrets.GITHUB_TOKEN }}`, `auth_env: GITHUB_TOKEN`, `os.environ["GITHUB_TOKEN"]`,
  # or documentation mentioning the variable name. Matching the bare name produced
  # false positives on safe CI config and on the token-in-gitconfig security docs.
  if git show ":$f" 2>/dev/null \
       | grep -vE '(secrets\.|env\.|vars\.|\$\{|environ|getenv|auth_env|setenv|delenv)' \
       | grep -qE '(OPENAI_API_KEY|ANTHROPIC_API_KEY|GITHUB_TOKEN|AWS_SECRET[A-Z_]*)[[:space:]]*[:=][[:space:]]*["\x27]?[A-Za-z0-9/_+-]{16,}'; then
    fail "Sensitive environment variable assigned a literal value in $f — use .env or a secrets manager"
    SECRETS_ERRORS=$((SECRETS_ERRORS + 1))
  fi
done

if [ "$SECRETS_ERRORS" -eq 0 ]; then
  echo "✅ Secrets detection passed"
else
  echo "❌ Secrets detection found $SECRETS_ERRORS issue(s)"
fi

# NOTE (2026-08-13 infra consolidation): the former CHECK 5 (contract
# validation) is removed — a narrow grep heuristic for @property/@staticmethod
# decorator mismatches that was warn-only ($CONTRACT_ERRORS was never added
# to $ERRORS) and never blocked a commit.

# ── CHECK 3: FILE PERMISSIONS (no executable bits on .md/.yaml/.txt) ──────────
echo ""
echo "🔍 CHECK 3: File permissions..."

PERMS_ERRORS=0

# Check that documentation and config files are not executable
for ext in "md" "yaml" "yml" "txt" "json" "jsonc"; do
  STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.$ext$" || true)
  
  for docfile in $STAGED_DOCS; do
    [ -f "$docfile" ] || continue
    
    # Check if file is executable
    if [ -x "$docfile" ]; then
      fail "Documentation/config file should not be executable: $docfile"
      fail "  Fix: chmod -x $docfile"
      PERMS_ERRORS=$((PERMS_ERRORS + 1))
    fi
  done
done

if [ "$PERMS_ERRORS" -eq 0 ]; then
  echo "✅ File permissions check passed"
else
  echo "❌ File permissions check found $PERMS_ERRORS issue(s)"
  ERRORS=$((ERRORS + PERMS_ERRORS))
fi

echo ""
echo "════════════════════════════════════════════════════════════════════════════════"
echo ""
# Exemption: renderer/scripts/ is the build-time installation path (allowed)
if git diff --cached --name-only | grep -qE '^orchestration/scripts/.*\.(py|sh)$'; then
  fail "VIOLATION: External scripts in orchestration/scripts/ — all work must flow through DELEGATE/HANDBACK protocol (docs/SPEC.md)"
fi

if git diff --cached --name-only | grep -qE '^orchestration/config/.*\.cron$'; then
  fail "VIOLATION: Cron files in orchestration/config/ — use DELEGATE/HANDBACK direct sub-agent spawn instead (docs/SPEC.md)"
fi

# ─── Section: Agent frontmatter consistency check ───────────────────────────
# Validate that src/agents/*-agent.md frontmatter model/effort fields
# match the canonical values in src/AGENTS.md.
# This prevents silent drift between source files and the canonical table.

validate_agent_frontmatter() {
	local repo_root="$1"
	local agents_md="$repo_root/src/AGENTS.md"
	local src_agents="$repo_root/src/agents"
	local errors=0
	
	# Check bypass flag
	if [ "${BYPASS_HOOK_VALIDATION:-false}" = "true" ]; then
		echo "⚠️  pre-commit: BYPASS_HOOK_VALIDATION=true — skipping frontmatter check" >&2
		return 0
	fi
	
	# Source shared lib for extract_fm, parse_agents_md, lookup_agent_metadata
	# shellcheck source=../renderer/lib/render-lib.sh
	source "$repo_root/renderer/lib/render-lib.sh" 2>/dev/null || {
		echo "⚠️  pre-commit: could not source render-lib.sh — skipping frontmatter check" >&2
		return 0
	}
	
	# Parse canonical metadata into a temp file
	local agents_map
	agents_map=$(mktemp)
	trap "rm -f '$agents_map'" RETURN
	
	if ! parse_agents_md "$agents_md" > "$agents_map" 2>/dev/null; then
		echo "⚠️  pre-commit: could not parse $agents_md — skipping frontmatter check" >&2
		return 0
	fi
	
	if [ ! -s "$agents_map" ]; then
		echo "⚠️  pre-commit: $agents_md yielded no agent entries — skipping frontmatter check" >&2
		return 0
	fi
	
	# Check each staged agent file
	for agent_file in "$src_agents"/*-agent.md; do
		[ -f "$agent_file" ] || continue
		
		agent_name=$(basename "$agent_file" "-agent.md")
		
		# Only check staged files (files that are being committed)
		if ! git diff --cached --name-only | grep -q "src/agents/${agent_name}-agent.md"; then
			continue
		fi
		
		# Get frontmatter model and effort
		fm_model=$(extract_fm "$agent_file" "model" 2>/dev/null || true)
		fm_effort=$(extract_fm "$agent_file" "effort" 2>/dev/null || true)
		
		# Get canonical values
		canonical=$(lookup_agent_metadata "$agent_name" "$agents_map")
		if [ -z "$canonical" ]; then
			# Agent not in src/AGENTS.md — skip (may be a new agent being added)
			continue
		fi

		canonical_model=$(echo "$canonical" | cut -d'|' -f1)
		canonical_effort=$(echo "$canonical" | cut -d'|' -f2)

		# Compare model
		if [ -n "$fm_model" ] && [ "$fm_model" != "$canonical_model" ]; then
			echo "❌ pre-commit: $agent_file model mismatch" >&2
			echo "   frontmatter: model: $fm_model" >&2
			echo "   src/AGENTS.md: model: $canonical_model" >&2
			echo "   Fix: update frontmatter or src/AGENTS.md to match" >&2
			errors=$((errors + 1))
		fi

		# Compare effort
		if [ -n "$fm_effort" ] && [ "$fm_effort" != "$canonical_effort" ]; then
			echo "❌ pre-commit: $agent_file effort mismatch" >&2
			echo "   frontmatter: effort: $fm_effort" >&2
			echo "   src/AGENTS.md: effort: $canonical_effort" >&2
			echo "   Fix: update frontmatter or src/AGENTS.md to match" >&2
			errors=$((errors + 1))
		fi
	done
	
	return $errors
}

# Run validation (only if src/AGENTS.md and src/agents/ exist)
REPO_ROOT_HOOK=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [ -f "$REPO_ROOT_HOOK/src/AGENTS.md" ] && [ -d "$REPO_ROOT_HOOK/src/agents" ]; then
	if ! validate_agent_frontmatter "$REPO_ROOT_HOOK"; then
		echo "" >&2
		echo "💡 To bypass this check (emergency only): BYPASS_HOOK_VALIDATION=true git commit" >&2
		ERRORS=$((ERRORS + 1))
	fi
fi
# ─── End: Agent frontmatter consistency check ────────────────────────────────

# NOTE (2026-08-13 infra consolidation): a duplicate secret-detection block
# used to live here — the exact same api_key/secret_key/AWS-key patterns as
# CHECK 2 above, re-run against the same staged files. CHECK 2 is a superset
# (it also catches literal-valued sensitive env vars), so the duplicate is
# removed rather than merged.

# ── 3. YAML well-formedness ────────────────────────────────────────────────────
if command -v python3 >/dev/null 2>&1; then
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yaml|yml)$' || true); do
    [ -f "$f" ] || continue
    if ! git show ":$f" 2>/dev/null | python3 -c "import sys,yaml; yaml.safe_load(sys.stdin)" 2>/dev/null; then
      fail "Invalid YAML: $f"
    fi
  done

  # JSON well-formedness
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.json(c)?$' || true); do
    [ -f "$f" ] || continue
    # Strip JSONC comments before parsing
    if ! git show ":$f" 2>/dev/null | python3 -c "
import sys, re, json
content = sys.stdin.read()
# Strip // comments (not inside strings)
content = re.sub(r'(?m)//.*$', '', content)
# Strip /* */ comments
content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
json.loads(content)
" 2>/dev/null; then
      warn "Possible JSON syntax issue in $f (JSONC comments stripped before check)"
    fi
  done
fi

# ─── Section: OpenCode harness config validation ─────────────────────────────
# Security-critical: opencode.jsonc errors have broken the OpenCode CLI twice.
# The validator (scripts/validate_opencode_config.py) documents each rule it
# enforces, and is the reference for what a valid config looks like. When staged, run
# the full schema validator (scripts/validate_opencode_config.py) and BLOCK the
# commit on any ERROR finding. Warnings are surfaced but do not block.
#
# Bypass: BYPASS_HOOK_VALIDATION=true git commit  (emergency only)
if git diff --cached --name-only | grep -qE '^opencode\.jsonc$'; then
  if [ "${BYPASS_HOOK_VALIDATION:-false}" = "true" ]; then
    warn "BYPASS_HOOK_VALIDATION=true — skipping opencode.jsonc validation"
  elif [ -f "$REPO_ROOT_HOOK/scripts/validate_opencode_config.py" ] && command -v python3 >/dev/null 2>&1; then
    echo "🔒 Validating staged opencode.jsonc…"
    # Validate the STAGED content (not the working tree) so amendments are caught.
    staged_tmp="$(mktemp -t opencode.jsonc.staged.XXXXXX)"
    trap "rm -f '$staged_tmp'" EXIT
    git show ":opencode.jsonc" > "$staged_tmp" 2>/dev/null || true
    if ! ( cd "$REPO_ROOT_HOOK" && python3 scripts/validate_opencode_config.py "$staged_tmp" ); then
      fail "opencode.jsonc validation failed — see errors above; run 'python3 scripts/validate_opencode_config.py opencode.jsonc' to reproduce"
    fi
  else
    warn "opencode.jsonc staged but validator not available — install scripts/validate_opencode_config.py"
  fi
fi
# ─── End: OpenCode harness config validation ─────────────────────────────────

# ── 4. No bypass markers in committed code ────────────────────────────────────
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|sh|bash)$' || true); do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qE '(--no-verify|SKIP_HOOKS=1)'; then
    warn "$f contains --no-verify or SKIP_HOOKS=1 — ensure this is intentional"
  fi
done

# NOTE: versioning is CI/CD-driven (git tags auto-created by
# mathieudutour/github-tag-action on merge to main) — there is no
# version-manager step in this hook. (2026-08-13: removed a ~60-line inert
# commented-out block that referenced a version-manager skill deleted well
# before this repo's current skill roster.)

# ─── Section: Orphaned Bytecode Check ──────────────────────────────────────
# CRITICAL for file loss prevention: Reject commits with orphaned .pyc files
# or .pyc without corresponding .py source.
#
# Background: Background agents create Python files. If .pyc exists without
# .py source (or .pyc is newer than .py), pytest can load tests from bytecode
# cache, masking the missing source files until tests fail later.
#
# Prevention: This check ensures:
#   1. No .pyc files are ever staged for commit (bytecode = gitignore)
#   2. No test sources from .pyc with missing .py
#   3. Warn if .pyc newer than .py (indicates stale .py)
#

echo ""
echo "🔒 Validating source file integrity..."

SOURCE_ERRORS=0
SOURCE_WARNINGS=0

# Check 1: No .pyc files staged (bytecode should NEVER be committed)
if git diff --cached --name-only | grep -qE '\.pyc$'; then
    STAGED_PYC=$(git diff --cached --name-only | grep '\.pyc$' || true)
    for f in $STAGED_PYC; do
        fail "Staged .pyc file detected (bytecode must not be version controlled): $f"
        fail "  Fix: git reset HEAD $f && echo '*.pyc' >> .gitignore"
        SOURCE_ERRORS=$((SOURCE_ERRORS + 1))
    done
fi

# Check 2: For each .py being staged, check for timestamp mismatch with .pyc
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
for py_file in $STAGED_PY; do
    [ -f "$py_file" ] || continue
    
    dir=$(dirname "$py_file")
    base=$(basename "$py_file" .py)
    
    # Try to find corresponding .pyc in __pycache__
    if [ -d "$dir/__pycache__" ]; then
        for pyc in "$dir"/__pycache__/"${base}"*.pyc; do
        if [ -f "$pyc" ]; then
            # Compare timestamps (platform-specific)
            if command -v stat >/dev/null 2>&1; then
                # Try GNU stat (Linux)
                py_mtime=$(stat -c %Y "$py_file" 2>/dev/null || true)
                pyc_mtime=$(stat -c %Y "$pyc" 2>/dev/null || true)
                
                # Fall back to BSD stat (macOS) if GNU stat fails
                if [ -z "$py_mtime" ]; then
                    py_mtime=$(stat -f %m "$py_file" 2>/dev/null || echo 0)
                    pyc_mtime=$(stat -f %m "$pyc" 2>/dev/null || echo 0)
                fi
                
                # Check if .pyc is newer than .py (suggests .py not regenerated)
                if [ "$pyc_mtime" -gt "$py_mtime" ] 2>/dev/null; then
                    warn "⚠️  Bytecode newer than source (stale .py?): $py_file"
                    warn "    .pyc file: $pyc"
                    warn "    Consider: rm -rf $dir/__pycache__ && python3 -m py_compile $py_file"
                    SOURCE_WARNINGS=$((SOURCE_WARNINGS + 1))
                fi
            fi
        fi
    done
   fi
done

# Check 3: For test files being added, verify source implementation exists
STAGED_TESTS=$(git diff --cached --name-only --diff-filter=A | grep '_test\.py$' || true)
for test_file in $STAGED_TESTS; do
    if [ ! -f "$test_file" ]; then
        fail "Test file not found on disk (cannot verify implementation): $test_file"
        SOURCE_ERRORS=$((SOURCE_ERRORS + 1))
        continue
    fi
    
    # For test files in skills/, verify corresponding implementation is staged
    if [[ "$test_file" == skills/* ]]; then
        test_dir=$(dirname "$test_file")
        test_base=$(basename "$test_file" _test.py)
        impl_file="$test_dir/${test_base}.py"
        
        # Check if implementation file is being added alongside test
        if [ ! -f "$impl_file" ]; then
            warn "⚠️  Test file without implementation (may be from orphaned .pyc): $test_file"
            warn "    Expected implementation: $impl_file"
            SOURCE_WARNINGS=$((SOURCE_WARNINGS + 1))
        fi
    fi
done

if [ "$SOURCE_ERRORS" -gt 0 ]; then
    fail "$SOURCE_ERRORS source file integrity issue(s) found"
fi

if [ "$SOURCE_WARNINGS" -gt 0 ]; then
    echo "⚠️  $SOURCE_WARNINGS warning(s) in source file integrity check"
fi

echo "✅ Source file integrity check passed"

# ─── End: Orphaned Bytecode Check ──────────────────────────────────────────────

# ─── Section: Model Naming Compliance Enforcement ────────────────────────────────
# SPEC locked: 2026-05-26 (docs/SPEC.md - Model Naming Architecture)
#
# Enforcement: Model naming is PERMANENTLY LOCKED via:
#   1. Source agents MUST use canonical format: claude-{variant}-\d+\.\d+ (DOTS)
#   2. NO GPT models allowed anywhere
#   3. NO unversioned models (claude-opus without -4.7)
#   4. Tests validate all renderers transform correctly per-harness
#
# Rationale: Model naming has broken repeatedly; this is non-negotiable.
# Philosophy: POSITIVE ENFORCEMENT — we enforce locked models by choice, not forbidden patterns.
#

echo ""
echo "🔒 Validating model naming compliance (LOCKED models)..."

# Source locked models configuration
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/LOCKED_MODELS.sh
source "$HOOKS_DIR/LOCKED_MODELS.sh" 2>/dev/null || {
    echo "⚠️  pre-commit: could not source LOCKED_MODELS.sh — skipping model compliance check" >&2
}

MODEL_ERRORS=0

# Validate source agents use models from LOCKED_MODELS (only if models are locked)
if declare -f is_model_locked >/dev/null 2>&1; then
    STAGED_MODEL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|py|yaml|yml)$' || true)
    for file in $STAGED_MODEL_FILES; do
        [ -f "$file" ] || continue

        # Only check source agent files
        if [[ "$file" != src/agents/* ]]; then
            continue
        fi

        # Extract model from staged content (from frontmatter)
        staged_content=$(git show ":$file" 2>/dev/null)
        # Guard: grep -E returns 1 when no match; under pipefail+set-e this would abort.
        model=$( { echo "$staged_content" | grep -E '^model:\s*' | head -1 | awk '{print $2}' | tr -d '"'"'"''; } || true)

        if [ -z "$model" ]; then
            # No model field found — skip (might not be a full agent file)
            continue
        fi

        # Check if model is in locked set
        if ! is_model_locked "$model"; then
            fail "❌ Model not in locked set: $file"
            fail "   Model: $model"
            fail "   Locked models (approved choices):"
            for locked_model in "${LOCKED_MODELS[@]}"; do
                fail "     - $locked_model"
            done
            fail "   To request a model change, contact the Orchestrator"
            fail "   → Include: agent name and reason for the change"
            MODEL_ERRORS=$((MODEL_ERRORS + 1))
        fi
    done

    if [ "$MODEL_ERRORS" -gt 0 ]; then
        echo ""
        echo "❌ pre-commit: $MODEL_ERRORS model compliance violation(s) found"
        fail "Models are LOCKED by choice. See .githooks/LOCKED_MODELS.sh for approved models"
        ERRORS=$((ERRORS + MODEL_ERRORS))
    fi
fi

# ─── End: Model Naming Compliance Enforcement ────────────────────────────────

# ─── DELEGATE/HANDBACK Protocol Validation ─────────────────────────────────────
# Validates DELEGATE and HANDBACK YAML files committed to ensure protocol compliance.
#
# Canonical authority: docs/specs/protocol-core-v1.0.yaml
#                      src/skills/protocol-validator/scripts/protocol_validator.py
#
# DELEGATE required core fields (canonical schema):
#   - task_id: kebab-case, 3-50 chars (^[a-z0-9][a-z0-9\-]{1,48}[a-z0-9]$)
#   - agent:   hyphenated role name (e.g. senior-engineer, NOT senior_engineer)
#   - scope:   string, >=15 words
#   - plan:    non-empty list
#   - success_criteria: non-empty list
#   - context: string or array
#   - skill:   string
#
# HANDBACK required core fields (canonical schema):
#   - task_id: string
#   - status:  success | failure | partial | blocked | escalate
#   - output:  any value
#   - metrics: object with quality (0.0-1.0), tokens (int), cost (float), duration_seconds (float)
#
# Discriminator field: handoff_type: DELEGATE | HANDBACK (canonical)
#   Backward compat: type: DELEGATE | HANDBACK also accepted, but produces a deprecation WARNING.
#   Files using type: will be validated normally; committer is warned to migrate to handoff_type:.
#
# Bypass: BYPASS_HOOK_VALIDATION=true (for emergency) or SKIP_HOOKS=1

# Local message helper for protocol violations. Echoes to stdout (tests assert on
# stdout, e.g. "status" in result.stdout) and increments PROTOCOL_ERRORS via the
# explicit counter below — it does NOT touch the global fail()/ERRORS to avoid
# double-counting; ERRORS is reconciled once at the end of this block.
pfail() {
  echo "❌ $1"
}

echo ""
echo "🔐 Validating DELEGATE/HANDBACK protocol files..."

PROTOCOL_ERRORS=0

# ── Inline self-test: backward-compat detection for type: vs handoff_type: ──────
# This test runs every time the hook runs and verifies that:
#   1. Files using type: DELEGATE are detected (backward compat) and produce a warning
#   2. Files using handoff_type: DELEGATE are detected and pass through to validation
#   3. Files with neither field are correctly skipped
# If this self-test fails the hook aborts immediately before checking real staged files.
_protocol_selftest() {
  local old_fmt new_fmt neither_fmt
  old_fmt=$'task_id: selftest-old\ntype: DELEGATE\nagent: engineer\nscope: test scope\nplan:\n  - step one'
  new_fmt=$'task_id: selftest-new\nhandoff_type: DELEGATE\nagent: engineer\nscope: test scope\nplan:\n  - step one'
  neither_fmt=$'task_id: selftest-neither\nsome_key: value'

  # Old format (type:) must be detected as a protocol file
  if ! echo "$old_fmt" | grep -qE "^(handoff_type|type):\s*(DELEGATE|HANDBACK)"; then
    echo "❌ protocol selftest FAILED: old format (type:) not detected" >&2
    return 1
  fi

  # New format (handoff_type:) must be detected as a protocol file
  if ! echo "$new_fmt" | grep -qE "^(handoff_type|type):\s*(DELEGATE|HANDBACK)"; then
    echo "❌ protocol selftest FAILED: new format (handoff_type:) not detected" >&2
    return 1
  fi

  # Neither format must NOT be detected as a protocol file
  if echo "$neither_fmt" | grep -qE "^(handoff_type|type):\s*(DELEGATE|HANDBACK)"; then
    echo "❌ protocol selftest FAILED: non-protocol file incorrectly detected" >&2
    return 1
  fi

  return 0
}

if ! _protocol_selftest; then
  echo "❌ pre-commit: DELEGATE/HANDBACK protocol self-test failed — hook is broken, aborting"
  exit 1
fi

# Check bypass flag first
if [ "${BYPASS_HOOK_VALIDATION:-false}" = "true" ]; then
  echo "⚠️  pre-commit: BYPASS_HOOK_VALIDATION=true — skipping DELEGATE/HANDBACK validation" >&2
else
  # Get all staged YAML/YML files
  STAGED_YAML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yaml|yml)$' || true)

  # Count of protocol files actually validated, tallied as we go. This used to be
  # recomputed after the loop by re-running the identical `git show` + grep scan
  # purely to produce a number; the loop already knows.
  PROTOCOL_FILE_COUNT=0

  for file in $STAGED_YAML_FILES; do
    [ -f "$file" ] || continue

    # Get file content from staging area
    file_content=$(git show ":$file" 2>/dev/null) || continue

    # Skip if not a DELEGATE or HANDBACK file (accept both discriminator forms)
    if ! echo "$file_content" | grep -qE "^(handoff_type|type):\s*(DELEGATE|HANDBACK)"; then
      continue
    fi
    PROTOCOL_FILE_COUNT=$((PROTOCOL_FILE_COUNT + 1))

    # Detect which discriminator field is used. Warn on deprecated type: form.
    uses_deprecated_type=false
    if echo "$file_content" | grep -qE "^type:\s*(DELEGATE|HANDBACK)"; then
      if ! echo "$file_content" | grep -qE "^handoff_type:\s*"; then
        uses_deprecated_type=true
        warn "$file uses deprecated discriminator 'type:' — migrate to 'handoff_type:' (will become an error in next major version)"
      fi
    fi

    # Extract the handoff type value from whichever discriminator is present
    # Use awk for portable field extraction (avoids macOS sed \s issue)
    if echo "$file_content" | grep -qE "^handoff_type:[[:space:]]*"; then
      handoff_type=$(echo "$file_content" | awk '/^handoff_type:/{print $2; exit}')
    else
      handoff_type=$(echo "$file_content" | awk '/^type:/{print $2; exit}')
    fi

    case "$handoff_type" in
      DELEGATE)
        # Validate DELEGATE protocol (canonical schema: docs/specs/protocol-core-v1.0.yaml)
        task_id=$(echo "$file_content" | awk '/^task_id:/{print $2; exit}' || true)
        agent=$(echo "$file_content" | awk '/^agent:/{print $2; exit}' || true)
        plan=$(echo "$file_content" | grep "^plan:" | head -1 || true)
        scope=$(echo "$file_content" | awk '/^scope:/{print $2; exit}' || true)
        success_criteria=$(echo "$file_content" | grep "^success_criteria:" | head -1 || true)

        # Check for secret patterns
        if echo "$file_content" | grep -qiE "^\s*(password|api_key|secret|token|credential):\s*"; then
          pfail "🔓 SECURITY: DELEGATE file $file contains secret field(s) — remove before committing"
          pfail "   → Use context/notes to reference secrets, never hardcode"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check task_id (canonical: kebab-case, 3-50 chars, ^[a-z0-9][a-z0-9\-]{1,48}[a-z0-9]$)
        if [ -z "$task_id" ]; then
          pfail "DELEGATE $file: missing required field 'task_id'"
          pfail "   → Format: kebab-case, 3-50 chars (e.g., my-task-123 or 2026-05-16-impl-feature)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$task_id" | grep -qE '^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$'; then
          pfail "DELEGATE $file: invalid task_id format '$task_id'"
          pfail "   → Must be: kebab-case, 3-50 chars (e.g., my-task-123)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check agent validity (canonical: hyphenated names, per VALID_AGENTS in protocol_validator.py)
        if [ -z "$agent" ]; then
          pfail "DELEGATE $file: missing required field 'agent'"
          pfail "   → Valid agents: engineer, senior-engineer, lead-engineer, principal-engineer,"
          pfail "                   security-engineer, quality-engineer, model-engineer, orchestrator"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$agent" | grep -qE '^(orchestrator|engineer|senior-engineer|lead-engineer|principal-engineer|security-engineer|quality-engineer|model-engineer)$'; then
          pfail "DELEGATE $file: invalid agent '$agent'"
          pfail "   → Valid agents: engineer, senior-engineer, lead-engineer, principal-engineer,"
          pfail "                   security-engineer, quality-engineer, model-engineer, orchestrator"
          pfail "   → Note: use hyphens not underscores (senior-engineer, not senior_engineer)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check plan presence (must be a non-empty list)
        if [ -z "$plan" ]; then
          pfail "DELEGATE $file: missing required field 'plan'"
          pfail "   → plan must be a non-empty list (>= 2 items)"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check success_criteria presence
        if [ -z "$success_criteria" ]; then
          pfail "DELEGATE $file: missing required field 'success_criteria'"
          pfail "   → success_criteria must be a non-empty list"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi
        ;;

      HANDBACK)
        # Validate HANDBACK protocol (canonical schema: docs/specs/protocol-core-v1.0.yaml)
        task_id=$(echo "$file_content" | awk '/^task_id:/{print $2; exit}' || true)
        status=$(echo "$file_content" | awk '/^status:/{print $2; exit}' || true)
        # metrics: is a block key — check for its presence and required sub-fields
        metrics_block=$(echo "$file_content" | grep "^metrics:" | head -1 || true)
        metrics_quality=$(echo "$file_content" | awk '/^[[:space:]]+quality:/{print $2; exit}' || true)
        metrics_tokens=$(echo "$file_content" | awk '/^[[:space:]]+tokens:/{print $2; exit}' || true)
        metrics_cost=$(echo "$file_content" | awk '/^[[:space:]]+cost:/{print $2; exit}' || true)
        metrics_duration=$(echo "$file_content" | awk '/^[[:space:]]+duration_seconds:/{print $2; exit}' || true)

        # Check for secret patterns
        if echo "$file_content" | grep -qiE "^\s*(password|api_key|secret|token|credential):\s*"; then
          pfail "🔓 SECURITY: HANDBACK file $file contains secret field(s) — remove before committing"
          pfail "   → Use output/flags fields to reference, never hardcode"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check task_id
        if [ -z "$task_id" ]; then
          pfail "HANDBACK $file: missing required field 'task_id'"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check status validity (canonical: success|failure|partial|blocked|escalate)
        if [ -z "$status" ]; then
          pfail "HANDBACK $file: missing required field 'status'"
          pfail "   → Valid statuses: success, failure, partial, blocked, escalate"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        elif ! echo "$status" | grep -qE '^(success|failure|partial|blocked|escalate)$'; then
          pfail "HANDBACK $file: invalid status '$status'"
          pfail "   → Valid statuses: success, failure, partial, blocked, escalate"
          pfail "   → Note: 'complete' and 'failed' are NOT valid (use 'success' and 'failure')"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        fi

        # Check metrics block (canonical: nested object with quality, tokens, cost, duration_seconds)
        if [ -z "$metrics_block" ]; then
          pfail "HANDBACK $file: missing required field 'metrics'"
          pfail "   → metrics must be an object with: quality (0.0-1.0), tokens (int),"
          pfail "     cost (float), duration_seconds (float)"
          pfail "   → Example:"
          pfail "     metrics:"
          pfail "       quality: 0.92"
          pfail "       tokens: 5000"
          pfail "       cost: 0.09"
          pfail "       duration_seconds: 42"
          PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
        else
          # Check required sub-fields within metrics
          if [ -z "$metrics_quality" ]; then
            pfail "HANDBACK $file: missing required field 'metrics.quality'"
            pfail "   → Must be a float 0.0–1.0"
            PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
          fi
          if [ -z "$metrics_tokens" ]; then
            pfail "HANDBACK $file: missing required field 'metrics.tokens'"
            pfail "   → Must be a non-negative integer"
            PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
          fi
          if [ -z "$metrics_cost" ]; then
            pfail "HANDBACK $file: missing required field 'metrics.cost'"
            pfail "   → Must be a non-negative float (USD)"
            PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
          fi
          if [ -z "$metrics_duration" ]; then
            pfail "HANDBACK $file: missing required field 'metrics.duration_seconds'"
            pfail "   → Must be a non-negative float (wall-clock seconds)"
            PROTOCOL_ERRORS=$((PROTOCOL_ERRORS + 1))
          fi
        fi
        ;;
    esac
  done

  if [ "$PROTOCOL_ERRORS" -gt 0 ]; then
    echo ""
    echo "❌ pre-commit: $PROTOCOL_ERRORS DELEGATE/HANDBACK validation error(s) found"
    echo "   Canonical schema: docs/specs/protocol-core-v1.0.yaml"
    echo "   Emergency bypass (document reason in commit msg):"
    echo "   → BYPASS_HOOK_VALIDATION=true git commit (bypasses only DELEGATE/HANDBACK validation)"
    echo "   → SKIP_HOOKS=1 git commit (bypasses all checks)"
    ERRORS=$((ERRORS + PROTOCOL_ERRORS))
  else
    # Report when DELEGATE/HANDBACK files were validated successfully, using the
    # tally kept by the validation loop above.
    if [ "${PROTOCOL_FILE_COUNT:-0}" -gt 0 ]; then
      echo "✅ DELEGATE/HANDBACK validation passed ($PROTOCOL_FILE_COUNT protocol file(s) validated)"
    fi
  fi
fi

# ─── End: DELEGATE/HANDBACK Protocol Validation ────────────────────────────────


if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "❌ pre-commit: $ERRORS violation(s) found. Fix issues and re-commit."
  echo "   Emergency bypass: SKIP_HOOKS=1 git commit OR GIT_SKIP_HOOKS=1 git commit"
  echo "   (document reason in commit message)"
  exit 1
fi

echo "✅ pre-commit: all checks passed"
exit 0
