#!/usr/bin/env bash
# .githooks/post-merge — Post-merge workflow validation for agentic-engineers
#
# Fires automatically after: git merge, git pull
#
# Sections:
#   1. Documentation drift check (SPEC.md / AGENTS.md modified in merge)
#
# Install: git config core.hooksPath .githooks
# Bypass:  SKIP_HOOKS=1 (skips all sections; hook is informational only)
#
# Exit codes:
#   0 — always (this hook is informational; never blocks post-merge)
#
# Design: docs/architecture/SDLC-HOOKS-DESIGN.md §5.4
#
# NOTE (queue-removal, task-2026-08-13-queue-removal-code): this hook used to
# carry a queue cleanup check, a workflow state validation check, and a
# fire-and-forget span-capture DELEGATE writer, all operating on
# artifacts/queue/{incoming,processing,done}/ — a path that predates the
# ~/.agentic-engineers/{harness}/{session-id}/queue/ layout and was never
# populated in this repo. Dispatch is now a direct sub-agent spawn and the
# harness session transcript is the durable audit record, so the filesystem
# queue (and this hook's sections about it) has been removed entirely.

set -uo pipefail

# Squash merge flag: $1 = 1 if squash, 0 otherwise
SQUASH_MERGE="${1:-0}"

# Allow bypass
if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "⏭️  post-merge: SKIPPED (SKIP_HOOKS=1)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

WARNINGS=0

warn() {
  echo "⚠️  post-merge: $1"
  WARNINGS=$((WARNINGS + 1))
}

info() {
  echo "ℹ️  post-merge: $1"
}

# ── 1. DOCUMENTATION DRIFT CHECK ───────────────────────────────────────────────
# If SPEC.md or AGENTS.md were modified in this merge, warn that agent
# implementations may need updating.

if git rev-parse ORIG_HEAD >/dev/null 2>&1; then
  MODIFIED_DOCS=$(git diff ORIG_HEAD HEAD --name-only 2>/dev/null | grep -E 'docs/(SPEC|AGENTS)\.md' || true)
  if [ -n "$MODIFIED_DOCS" ]; then
    warn "Core documentation changed in this merge:"
    echo "$MODIFIED_DOCS" | while read -r doc; do
      echo "   • $doc"
    done
    echo "   Review agent implementations for compliance with updated spec."
    echo "   Run: /sdlc-check (OpenCode) to verify SPEC compliance."
  fi
fi

# ── RESULT ─────────────────────────────────────────────────────────────────────
echo ""
if [ "$WARNINGS" -gt 0 ]; then
  echo "⚠️  post-merge: $WARNINGS warning(s) — review above (non-blocking)"
else
  echo "✅ post-merge: all checks passed"
fi

# Always exit 0 — post-merge is informational only; never blocks
exit 0
