// agentic-engineers OpenCode configuration
// Integrates git hooks with OpenCode commands for SDLC enforcement
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "orchestrator",
  "model": "anthropic/claude-haiku-4-5",

  // Compaction settings for token efficiency
  "compaction": {
    "auto": true,
    "reserved": 30000
  },

  // Permission model for tool access
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow"
  },

  // OpenCode commands for SDLC workflow
  "command": {
    "sdlc-check": {
      "description": "Validate SDLC workflow compliance — check pending DELEGATEs and HANDBACKs",
      "agent": "orchestrator",
      "subtask": true,
      "template": "Validate SDLC workflow compliance by reviewing all pending DELEGATEs and HANDBACKs in the current session, verifying protocol compliance, and ensuring no protocol violations."
    },
    "hooks-install": {
      "description": "Install git enforcement hooks (core.hooksPath = .githooks)",
      "agent": "orchestrator",
      "template": "Install and configure git enforcement hooks from .githooks/ directory. Set core.hooksPath = .githooks and verify all hooks are executable and properly configured."
    }
  }

}
