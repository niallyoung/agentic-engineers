# Production Environment Configuration for Continuous Polling Loop Automation
# Source this file before running bin/run-automation-controller.sh

# ─── Polling Configuration ───────────────────────────────────────────────────

# Polling interval in seconds (how often to check queue)
POLL_INTERVAL_SECONDS=5

# Daemon mode (true = run indefinitely, false = exit after idle timeout)
AUTOMATION_DAEMON_MODE=true

# Idle timeout in seconds (only used if DAEMON_MODE=false)
AUTOMATION_IDLE_TIMEOUT=300

# Max cycles before exit (for testing/debugging, unset for unlimited)
# AUTOMATION_MAX_CYCLES=100

# ─── Logging Configuration ───────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (will be created if not exists)
# Default: logs/automation-{timestamp}.log
# LOG_FILE=/var/log/orchestrator/automation.log

# ─── Metrics Configuration ───────────────────────────────────────────────────

# Metrics file path (JSON format for monitoring)
# Default: metrics/metrics-{timestamp}.json
# METRICS_FILE=/var/metrics/automation-metrics.json

# ─── Queue Configuration ────────────────────────────────────────────────────

# Queue directory (location of DELEGATE files)
# Default: data/queue
# ORCHESTRATOR_QUEUE_DIR=/opt/orchestrator/queue

# ─── Health Check Configuration ─────────────────────────────────────────────

# Health check endpoint port (0 to disable)
HEALTH_CHECK_PORT=9090

# ─── Python Configuration ───────────────────────────────────────────────────

# Python module path (if needed)
# PYTHONPATH=/opt/orchestrator

# ─── Signal Handling ────────────────────────────────────────────────────────

# Signal timeout for graceful shutdown (seconds)
SIGTERM_TIMEOUT=30

# ─── Performance Tuning ────────────────────────────────────────────────────

# CPU affinity (optional, for multi-core systems)
# CPU_AFFINITY="0-2"  # Use CPUs 0, 1, 2

# Memory limit (optional, for containerized environments)
# MEMORY_LIMIT="1024m"  # 1GB limit

# ─── Observability ─────────────────────────────────────────────────────────

# Enable structured logging (JSON format)
STRUCTURED_LOGGING=true

# Metrics format: prometheus|json|cloudwatch
METRICS_FORMAT=prometheus

# Tracing enabled (if using OpenTelemetry)
TRACING_ENABLED=false

# ─── Development/Testing ────────────────────────────────────────────────────

# Test mode (set for testing, unset for production)
# AUTOMATION_TEST_MODE=true

# Skip health checks during startup
# SKIP_HEALTH_CHECKS=false
