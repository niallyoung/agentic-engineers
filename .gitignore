# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
# Exception: renderer/lib/ is committed as source code. Both the directory
# entry and a recursive "**" re-inclusion are needed: a bare "!renderer/lib/"
# only re-includes the directory node itself, not files added under it later
# (a known gitignore gotcha where the broader "lib/" exclusion above still
# shadows individual files unless the negation is recursive).
!renderer/lib/
!renderer/lib/**
renderer/lib/__pycache__/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================================
# IDE AND EDITOR
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================================================
# TESTING
# ============================================================================
.coverage
.pytest_cache/
htmlcov/
.tox/

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env
.env.local
.env.production
.env.*.local

# ============================================================================
# RUNTIME DATA (DO NOT COMMIT)
# ============================================================================
logs/
metrics/
data/
artifacts/

# ============================================================================
# BUILD & TEMPORARY
# ============================================================================
# dist/ is generated output (src/ → dist/ → ~/.harness/ flow via make render-*)
# Regenerate with 'make render-*' targets. Do not commit.
*.tmp
temp/
dist/
# .claude is outside the repo (harness install target) — not committed here
.claude


# ============================================================================
# JAVASCRIPT / NODE
# ============================================================================
node_modules/
.next/

# ============================================================================
# COPILOT SPECIFIC
# ============================================================================
.copilot/session-state/

# ============================================================================
# TASK TRACKING (active working copy — use src/TODO.md.template as the format)
# ============================================================================
# Uncomment the line below to gitignore the active TODO.md.
# By default TODO.md IS committed so it can be the resume point across sessions.
# /TODO.md
# Session planning documents (working files, not source)
/PLAN.md
# ============================================================================
# AGENTIC-ENGINEERS RUNTIME ARTIFACTS (DO NOT COMMIT)
# ============================================================================
# Session-scoped runtime artifacts live here. Never commit.
.agentic-engineers/

# Generated coverage / compliance reports (build artifacts, not source)
coverage.json
COMPLIANCE_REPORT.json

# Regenerable skills audit output (produced by `python -m src.audit.run_audit`)
docs/archive/audits/SKILLS-AUDIT.md
