# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
!renderer/lib/  # Exception: renderer/lib/ is committed as source code
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================================
# IDE AND EDITOR
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================================================
# TESTING
# ============================================================================
.coverage
.pytest_cache/
htmlcov/
.tox/

# ============================================================================
# ENVIRONMENT & SECRETS
# ============================================================================
.env
.env.local
.env.production
.env.*.local

# ============================================================================
# RUNTIME DATA (DO NOT COMMIT)
# ============================================================================
logs/
metrics/
data/
artifacts/

# ============================================================================
# BUILD & TEMPORARY
# ============================================================================
# dist/ is generated output (src/ → dist/ → ~/.harness/ flow via make render-*)
# Regenerate with 'make render-*' targets. Do not commit.
*.tmp
temp/
dist/
# .claude is outside the repo (harness install target) — not committed here
.claude

# ============================================================================
# JAVASCRIPT / NODE
# ============================================================================
node_modules/
.next/

# ============================================================================
# COPILOT SPECIFIC
# ============================================================================
.copilot/session-state/

# ============================================================================
# TASK TRACKING (active working copy — use src/TODO.md.template as the format)
# ============================================================================
# Uncomment the line below to gitignore the active TODO.md.
# By default TODO.md IS committed so it can be the resume point across sessions.
# /TODO.md
# ============================================================================
# AGENTIC-ENGINEERS RUNTIME ARTIFACTS (DO NOT COMMIT)
# ============================================================================
# Multi-harness queue isolation: session-scoped artifacts live here.
# Structure: ~/.agentic-engineers/artifacts/{sessionID}/{harness}/
# Never commit — contains local queue state, metadata, and task files.
.agentic-engineers/

src/skills/agent_creator
src/skills/queue_management
src/skills/spec_management
src/skills/spec_validator
