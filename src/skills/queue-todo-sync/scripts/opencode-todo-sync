#!/usr/bin/env python3
"""
opencode-todo-sync CLI wrapper

Usage:
    opencode-todo-sync sync      # Perform bidirectional sync
    opencode-todo-sync report    # Generate weekly report
    opencode-todo-sync check     # Check for issues
"""

import sys
import argparse
from pathlib import Path

# Add skills directory to path
skills_dir = Path(__file__).parent.parent.parent
sys.path.insert(0, str(skills_dir))

from sync_todo import TodoSyncManager


def main():
    """Main CLI entry point"""
    parser = argparse.ArgumentParser(
        description="queue-todo-sync skill: Auto-sync queue ↔ TODO.md",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  opencode-todo-sync sync              # Sync all DELEGATEs and HANDBACKs
  opencode-todo-sync report            # Generate weekly report
  opencode-todo-sync check             # Check for conflicts and issues
  opencode-todo-sync sync --todo-path /path/to/TODO.md
        """,
    )

    parser.add_argument(
        "command",
        choices=["sync", "report", "check"],
        help="Command to execute",
    )

    parser.add_argument(
        "--todo-path",
        type=Path,
        default=Path.cwd() / "TODO.md",
        help="Path to TODO.md file (default: ./TODO.md)",
    )

    parser.add_argument(
        "--queue-path",
        type=Path,
        default=Path.cwd() / "artifacts" / "queue",
        help="Path to queue directory (default: ./artifacts/queue)",
    )

    parser.add_argument(
        "--report-output",
        type=Path,
        default=None,
        help="Output file for report (default: print to stdout)",
    )

    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Verbose output",
    )

    args = parser.parse_args()

    # Verify paths exist
    if not args.todo_path.exists():
        print(f"Error: TODO.md not found at {args.todo_path}", file=sys.stderr)
        return 1

    if not args.queue_path.exists():
        print(f"Error: Queue directory not found at {args.queue_path}", file=sys.stderr)
        return 1

    manager = TodoSyncManager(todo_path=args.todo_path, queue_path=args.queue_path)

    if args.command == "sync":
        result = manager.bidirectional_sync()
        print("✓ Sync complete:")
        print(f"  DELEGATEs synced: {result['delegates_synced']}")
        print(f"  HANDBACKs synced: {result['handbacks_synced']}")
        print(f"  Conflicts: {result['conflicts']}")
        print(f"  Orphaned: {result['orphaned']}")
        print(f"  Missing: {result['missing']}")

        if args.verbose:
            if result['conflicts'] > 0:
                print("\nConflicts detected:")
                for conflict in manager.conflicts:
                    print(f"  - {conflict.task_id}")

            orphaned = manager.detect_orphaned_tasks()
            if orphaned:
                print("\nOrphaned tasks:")
                for task in orphaned:
                    print(f"  - {task['task_id']}")

            missing = manager.detect_missing_tasks()
            if missing:
                print("\nMissing tasks:")
                for task in missing:
                    print(f"  - {task['task_id']}")

        return 0

    elif args.command == "report":
        report = manager.generate_weekly_report()
        report_text = report.generate()

        if args.report_output:
            report.write_to_file(args.report_output)
            print(f"✓ Report written to {args.report_output}")
        else:
            print(report_text)

        return 0

    elif args.command == "check":
        conflicts = manager.detect_conflicts()
        orphaned = manager.detect_orphaned_tasks()
        missing = manager.detect_missing_tasks()

        has_issues = len(conflicts) > 0 or len(orphaned) > 0 or len(missing) > 0

        if not has_issues:
            print("✓ No issues detected")
            return 0

        if conflicts:
            print(f"⚠ Found {len(conflicts)} conflicts:")
            for conflict in conflicts:
                print(f"  - {conflict.task_id}: {conflict.source}")

        if orphaned:
            print(f"⚠ Found {len(orphaned)} orphaned tasks:")
            for task in orphaned:
                print(f"  - {task['task_id']}")

        if missing:
            print(f"⚠ Found {len(missing)} missing tasks:")
            for task in missing:
                print(f"  - {task['task_id']}")

        return 1 if has_issues else 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
